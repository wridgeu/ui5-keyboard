{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "checkJs": true,
    // The oxlint plugins visit untyped ESLint AST nodes and import the untyped
    // `eslint` module; their visitor params are legitimately `any`. Relax
    // noImplicitAny so the check still catches real errors (typos, undefined
    // symbols, wrong arity/types against the typed Node APIs) without demanding
    // full AST annotations.
    "noImplicitAny": false,
    "noEmit": true
  },
  "include": ["./*.mjs", "../patches/*.mjs"],
  "exclude": ["../node_modules"]
}
