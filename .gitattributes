# Auto detect text files and perform LF normalization
* text=auto

# Force LF for these files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.less text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.patch text eol=lf

# Shell scripts and hooks
.githooks/* text eol=lf

# Binary assets - never normalize EOL or attempt text diffing
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# GitHub Linguist overrides
*.html linguist-vendored
*.less linguist-vendored
*.gen.d.ts linguist-generated
tools/oxlint/anti-slop/** linguist-vendored
