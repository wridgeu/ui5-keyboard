# ui5-test-runner output: the --report-dir the test:qunit scripts pass, plus the
# free-form sibling an ad-hoc run names for itself. Scoped to packages/ so the
# name glob cannot reach a reports/ or reporter/ directory elsewhere.
packages/*/report/
packages/*/report-*/

