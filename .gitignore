node_modules/
dist/
demo-dist/
.ui5/
.ui5-tooling-modules/
*.tsbuildinfo
coverage/
__screenshots__/
.generated-specs/
**/src/generated/

# Playwright runtime output (baselines live in __baselines__ and are committed)
test-results/
playwright-report/
.last-run.json

# ui5-test-runner output. Globbed because --report-dir is a free-form CLI
# argument: the npm scripts pass "report", but an ad-hoc run picks its own name
# (report-p6 from a --parallel benchmark), and a bare "report/" leaves that
# sitting in git status and failing fmt:check.
report*/
.nyc_output/

# @ui5/linter coverage report (written to cwd by `ui5lint --coverage`)
ui5lint-report.html

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# OpenCode scratch prompt files
prompt*.txt

# Local Claude/OpenCode workspace settings
.claude/
packages/**/.claude/
.superpowers/
.worktrees/

# Review notes
review.md

# Assembled GitHub Pages site (built by deploy-pages workflow / local verify)
_site/
