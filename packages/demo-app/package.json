{
  "name": "demo-hotkeys-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "ui5 serve --port 8080 -o index.html",
    "start:flp": "ui5 serve --config ui5-flp.yaml --port 8080 -o test/flp.html",
    "build": "ui5 build --clean-dest",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint:ui5": "ui5lint --ui5-config ui5.yaml"
  },
  "dependencies": {
    "@ui5/webcomponents": "~2.21.0",
    "kiosk-keyboard-webc": "*",
    "ui5-lib-hotkeys": "*",
    "ui5-lib-kiosk-keyboard": "*"
  },
  "devDependencies": {
    "@openui5/types": "1.147.1",
    "@sap-ux/preview-middleware": "~0.25.0",
    "@ui5/cli": "~4.0.51",
    "@ui5/linter": "~1.21.1",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.2",
    "ui5-middleware-livereload": "~3.3.0",
    "ui5-tooling-modules": "~3.35.0",
    "ui5-tooling-transpile": "~3.11.0"
  }
}
