{
  "name": "demo-hotkeys-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node -e \"import('node:fs').then(f=>{const src='../kiosk-keyboard-webc/dist/kiosk-keyboard.bundle.js';if(!f.existsSync(src)){console.error('Error: kiosk-keyboard-webc not built. Run npm run build from the repo root first.');process.exit(1)}f.mkdirSync('webapp/lib',{recursive:true});f.copyFileSync(src,'webapp/lib/kiosk-keyboard.bundle.js')})\"",
    "start": "ui5 serve --port 8080 -o index.html",
    "start:flp": "ui5 serve --config ui5-flp.yaml --port 8080 -o test/flp.html",
    "build": "ui5 build --clean-dest",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint:ui5": "ui5lint --ui5-config ui5.yaml"
  },
  "dependencies": {
    "@ui5/webcomponents": "^2.19.2",
    "kiosk-keyboard-webc": "*",
    "ui5-lib-hotkeys": "*",
    "ui5-lib-kiosk-keyboard": "*"
  },
  "devDependencies": {
    "@openui5/types": "1.144.0",
    "@sap-ux/preview-middleware": "^0.23.0",
    "@ui5/cli": "^4.0.44",
    "@ui5/linter": "^1.20.11",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "ui5-middleware-livereload": "^3.0.0",
    "ui5-tooling-modules": "^3.30.0",
    "ui5-tooling-transpile": "^3.9.0"
  }
}
