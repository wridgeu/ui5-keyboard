{
  "name": "demo-hotkeys-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "ui5 serve --port 8080 -o index.html",
    "start:flp": "ui5 serve --config ui5-flp.yaml --port 8080 -o test/flp.html",
    "build": "ui5 build --clean-dest",
    "build:pages": "ui5 build --config ui5-pages.yaml --all --clean-dest --include-task generateVersionInfo",
    "clean": "rimraf dist .ui5-tooling-modules",
    "typecheck": "tsc --noEmit",
    "lint:ui5": "ui5lint --ui5-config ui5.yaml"
  },
  "dependencies": {
    "@ui5/webcomponents": "~2.22.0",
    "kiosk-keyboard-webc": "*",
    "ui5-lib-hotkeys": "*",
    "ui5-lib-kiosk-keyboard": "*"
  },
  "devDependencies": {
    "@openui5/types": "1.149.0",
    "@sap-ux/preview-middleware": "~1.0.10",
    "@ui5/cli": "~4.0.55",
    "@ui5/linter": "~1.21.1",
    "ui5-middleware-livereload": "~3.3.1",
    "ui5-tooling-modules": "~3.36.1",
    "ui5-tooling-transpile": "~3.11.1"
  },
  "engines": {
    "node": ">=24"
  }
}
