{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "demo/hotkeys/*": ["./webapp/*"],
      "ui5/hotkeys/*": ["../hotkeys/src/*"],
      "ui5/kiosk/*": ["../kiosk-keyboard/src/*"]
    },
    "types": ["@openui5/types"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["webapp/**/*.ts", "../hotkeys/src/**/*.ts", "../kiosk-keyboard/src/**/*.ts"],
  "exclude": ["node_modules"]
}
