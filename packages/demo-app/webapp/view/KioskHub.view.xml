<mvc:View
    controllerName="demo.hotkeys.controller.KioskHub"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="Kiosk Keyboard Demos" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <content>
            <List
                headerText="Choose a Demo"
                items="{state>/kioskDemoEntries}"
                itemPress=".onScenarioPress">
                <StandardListItem
                    title="{state>title}"
                    description="{state>description}"
                    type="Navigation" />
            </List>
        </content>
    </Page>
</mvc:View>
