<mvc:View
    controllerName="demo.hotkeys.controller.KioskI18nExtensibility"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:kiosk="ui5.kiosk">
    <Page titleAlignment="Center" title="i18n Extensibility Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo rootRole="None" headerRole="Banner" />
        </landmarkInfo>
        <content>
            <MessageStrip
                text="Switch the i18n mode below to see how ARIA labels change. Special keys use icons: their translated text appears as aria-labels (for screen readers) and as visible text on the Space key."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

            <!-- i18n Mode selector -->
            <Panel headerText="i18n Mode" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <SegmentedButton width="100%" selectedKey="{i18nDemo>/activeMode}" selectionChange=".onModeChange">
                        <items>
                            <SegmentedButtonItem key="default" text="Default" />
                            <SegmentedButtonItem key="french" text="French" />
                            <SegmentedButtonItem key="override" text="Overrides" />
                            <SegmentedButtonItem key="hook" text="Hook" />
                        </items>
                    </SegmentedButton>
                    <Text text="{i18nDemo>/modeDescription}" class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

            <!-- ARIA Label Inspector -->
            <Panel headerText="Resolved ARIA Labels" class="sapUiSmallMarginBottom">
                <HBox wrap="Wrap" class="sapUiSmallMargin">
                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <layoutData>
                            <FlexItemData baseSize="11rem" growFactor="0" />
                        </layoutData>
                        <Label text="Keyboard label" />
                        <ObjectStatus text="{i18nDemo>/inspector/keyboardLabel}" state="Information" />
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <layoutData>
                            <FlexItemData baseSize="11rem" growFactor="0" />
                        </layoutData>
                        <Label text="Role description" />
                        <ObjectStatus text="{i18nDemo>/inspector/roleDescription}" state="Information" />
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <layoutData>
                            <FlexItemData baseSize="11rem" growFactor="0" />
                        </layoutData>
                        <Label text="Shift key" />
                        <ObjectStatus text="{i18nDemo>/inspector/shiftKey}" state="Information" />
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <layoutData>
                            <FlexItemData baseSize="11rem" growFactor="0" />
                        </layoutData>
                        <Label text="Enter key" />
                        <ObjectStatus text="{i18nDemo>/inspector/enterKey}" state="Information" />
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <layoutData>
                            <FlexItemData baseSize="11rem" growFactor="0" />
                        </layoutData>
                        <Label text="Backspace key" />
                        <ObjectStatus text="{i18nDemo>/inspector/backspaceKey}" state="Information" />
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <layoutData>
                            <FlexItemData baseSize="11rem" growFactor="0" />
                        </layoutData>
                        <Label text="Space key" />
                        <ObjectStatus text="{i18nDemo>/inspector/spaceKey}" state="Information" />
                    </VBox>
                </HBox>
            </Panel>

            <!-- Keyboard Preview (inline, always visible) -->
            <kiosk:KioskKeyboard
                id="i18nKeyboard"
                layout="qwerty" />
        </content>
    </Page>
</mvc:View>
