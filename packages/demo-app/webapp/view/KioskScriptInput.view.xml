<mvc:View
    controllerName="demo.hotkeys.controller.KioskScriptInput"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:kiosk="ui5.kiosk">
    <Page titleAlignment="Center" title="Script Input &amp; Middleware" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo rootRole="None" headerRole="Banner" />
        </landmarkInfo>
        <content>
            <Panel class="sapUiSmallMarginBottom" headerText="Japanese Kana">
                <VBox class="sapUiSmallMargin">
                    <Label text="Kana Input" labelFor="kanaInput" />
                    <Input
                        id="kanaInput"
                        placeholder="ひらがな入力"
                        width="100%" />
                    <kiosk:KioskKeyboard
                        id="kanaKeyboard"
                        layout="ja-kana"
                        autoType="true"
                        autoCompact="true"
                        controls="kanaInput"
                        class="sapUiSmallMarginTop" />
                    <Text
                        text="Dakuten/handakuten composition middleware active. autoCompact=&quot;true&quot; hands the keyboard to its ja-kana-compact rows at or below 352px and back above it; ja-kana declares that layout as its compact counterpart. Narrow the window to watch it swap."
                        class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

            <Panel class="sapUiSmallMarginBottom" headerText="Korean Hangul">
                <VBox class="sapUiSmallMargin">
                    <Label text="Hangul Input" labelFor="hangulInput" />
                    <Input
                        id="hangulInput"
                        placeholder="한글 입력"
                        width="100%" />
                    <kiosk:KioskKeyboard
                        id="hangulKeyboard"
                        layout="ko-hangul"
                        autoType="true"
                        controls="hangulInput"
                        class="sapUiSmallMarginTop" />
                    <Text text="Jamo-to-syllable composition middleware active" class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

            <Panel class="sapUiSmallMarginBottom" headerText="Korean Hangul, Composer Suppressed">
                <VBox class="sapUiSmallMargin">
                    <Label text="Uncomposed Jamo Input" labelFor="hangulDirectInput" />
                    <Input
                        id="hangulDirectInput"
                        placeholder="ㄱㅏㄴ"
                        width="100%" />
                    <kiosk:KioskKeyboard
                        id="hangulDirectKeyboard"
                        layout="ko-hangul"
                        autoType="true"
                        controls="hangulDirectInput"
                        class="sapUiSmallMarginTop">
                        <kiosk:customLayouts>
                            <!-- Rows-less overlay: same built-in keys, no composer. -->
                            <kiosk:CustomLayout name="ko-hangul" suppress="Middleware" />
                        </kiosk:customLayouts>
                    </kiosk:KioskKeyboard>
                    <Text
                        text="The same built-in layout with suppress=&quot;Middleware&quot;: jamo are typed straight into the field instead of composing into syllables. Type the same keys as above to compare."
                        class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

            <Panel class="sapUiSmallMarginBottom" headerText="Arabic">
                <VBox class="sapUiSmallMargin">
                    <Label text="Arabic Input" labelFor="arabicInput" />
                    <Input
                        id="arabicInput"
                        placeholder="اكتب هنا"
                        textDirection="RTL"
                        width="100%" />
                    <kiosk:KioskKeyboard
                        id="arabicKeyboard"
                        layout="arabic"
                        autoType="true"
                        controls="arabicInput"
                        class="sapUiSmallMarginTop" />
                    <Text text="RTL layout with Arabic-Indic numeral shift layer" class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

        </content>
    </Page>
</mvc:View>
