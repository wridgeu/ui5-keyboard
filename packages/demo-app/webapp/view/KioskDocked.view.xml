<mvc:View
    controllerName="demo.hotkeys.controller.KioskDocked"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:kiosk="ui5.kiosk"
    core:require="{ kioskLib: 'ui5/kiosk/library' }">
    <Page titleAlignment="Center" title="Docked Keyboard Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding demoDockedPage">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo rootRole="None" headerRole="Banner" />
        </landmarkInfo>
        <content>
            <Panel class="sapUiSmallMarginBottom" headerText="Controls">
                <VBox class="sapUiSmallMargin">
                    <HBox alignItems="Center">
                        <Label id="enabledLabel" text="Enabled:" class="sapUiSmallMarginEnd" />
                        <Switch state="{docked>/kioskEnabled}" ariaLabelledBy="enabledLabel" />
                    </HBox>
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label id="mobileKeyboardLabel" text="Mobile Keyboard:" class="sapUiSmallMarginEnd" />
                        <SegmentedButton selectedKey="{docked>/kioskMobileKeyboard}" ariaLabelledBy="mobileKeyboardLabel">
                            <items>
                                <SegmentedButtonItem key="Custom" text="Custom" />
                                <SegmentedButtonItem key="Native" text="Native" />
                                <SegmentedButtonItem key="Auto" text="Auto" />
                            </items>
                        </SegmentedButton>
                    </HBox>
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Layout:" labelFor="layoutSelect" class="sapUiSmallMarginEnd" />
                        <Select id="layoutSelect" selectedKey="{docked>/kioskLayout}"
                            items="{docked>/layouts}">
                            <core:Item key="{docked>key}" text="{docked>text}" />
                        </Select>
                    </HBox>
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label id="fKeyModeLabel" text="F-Key Mode:" class="sapUiSmallMarginEnd" />
                        <SegmentedButton selectedKey="{docked>/kioskFKeyMode}" ariaLabelledBy="fKeyModeLabel">
                            <items>
                                <SegmentedButtonItem key="Virtual" text="Virtual" />
                                <SegmentedButtonItem key="Native" text="Native" />
                                <SegmentedButtonItem key="None" text="None" />
                            </items>
                        </SegmentedButton>
                    </HBox>
                </VBox>
            </Panel>

            <Panel class="sapUiSmallMarginBottom" headerText="Docked Keyboard (tap any input)">
                <VBox class="sapUiSmallMargin">
                    <Text text="Tap an input field below. The keyboard slides up and auto-detects numpad for Number/Tel inputs. Press and hold a letter (or right-click) to open its accent variants, e.g. hold a for à á â ä." />
                    <Label text="Full Name" labelFor="nameInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="nameInput"
                        placeholder="John Doe"
                        width="100%" />
                    <Label text="Email" labelFor="emailInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="emailInput"
                        placeholder="john@example.com"
                        width="100%" />
                    <Label text="Age" labelFor="ageInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="ageInput"
                        type="Number"
                        placeholder="25"
                        width="100%" />
                    <Label text="Phone" labelFor="phoneInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="phoneInput"
                        type="Tel"
                        placeholder="+49 123 456789"
                        width="100%" />
                    <Label text="Notes" labelFor="notesInput" class="sapUiSmallMarginTop" />
                    <TextArea
                        id="notesInput"
                        placeholder="Additional notes..."
                        rows="3"
                        width="100%" />
                </VBox>
            </Panel>

            <Panel class="sapUiSmallMarginBottom" headerText="Inline Numpad">
                <VBox class="sapUiSmallMargin">
                    <core:InvisibleText id="numpadLabel" text="Inline numeric keypad" />
                    <Text id="numpadHint" text="A compact numeric keypad rendered inline (not docked)." />
                    <Input
                        id="numpadInput"
                        placeholder="Numeric input..."
                        class="sapUiSmallMarginTop"
                        width="12rem" />
                    <kiosk:KioskKeyboard
                        id="numpadKeyboard"
                        keyboardType="{= kioskLib.KeyboardType.Numpad }"
                        controls="numpadInput"
                        ariaLabelledBy="numpadLabel"
                        ariaDescribedBy="numpadHint"
                        class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

            <Panel class="sapUiSmallMarginBottom" headerText="Event Log">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{docked>/kioskLastKey}" state="Information" />
                    </HBox>
                    <HBox>
                        <Label text="Active Layout:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{docked>/kioskLayout}" state="Success" />
                    </HBox>
                    <HBox>
                        <Label text="F-Key Mode:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{docked>/kioskFKeyMode}" state="Information" />
                    </HBox>
                </VBox>
            </Panel>

            <kiosk:KioskKeyboard
                id="dockedKeyboard"
                docked="true"
                autoShow="true"
                autoType="true"
                accentVariants="true"
                controls="nameInput,emailInput,ageInput,phoneInput,notesInput"
                enabled="{docked>/kioskEnabled}"
                mobileKeyboard="{docked>/kioskMobileKeyboard}"
                fKeyMode="{docked>/kioskFKeyMode}"
                layout="{docked>/kioskLayout}"
                keyPress=".onKeyPress"
                layoutChange=".onDockedLayoutChange" />
        </content>
    </Page>
</mvc:View>
