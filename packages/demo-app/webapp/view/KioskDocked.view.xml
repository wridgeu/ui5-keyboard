<mvc:View
    controllerName="demo.hotkeys.controller.KioskDocked"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:kiosk="ui5.kiosk">
    <Page title="Docked Keyboard Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <content>
            <Panel class="sapUiSmallMarginBottom" headerText="Controls">
                <VBox class="sapUiSmallMargin">
                    <HBox alignItems="Center">
                        <Label text="Enabled:" class="sapUiSmallMarginEnd" />
                        <Switch state="{state>/kioskEnabled}" change=".onEnabledChange" />
                    </HBox>
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Mobile Keyboard:" class="sapUiSmallMarginEnd" />
                        <SegmentedButton selectedKey="{state>/kioskMobileKeyboard}" selectionChange=".onMobileKeyboardChange">
                            <items>
                                <SegmentedButtonItem key="Custom" text="Custom" />
                                <SegmentedButtonItem key="Native" text="Native" />
                                <SegmentedButtonItem key="Auto" text="Auto" />
                            </items>
                        </SegmentedButton>
                    </HBox>
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Layout:" class="sapUiSmallMarginEnd" />
                        <Select id="layoutSelect" change=".onLayoutChange" />
                    </HBox>
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="F-Key Mode:" class="sapUiSmallMarginEnd" />
                        <SegmentedButton selectedKey="{state>/kioskFKeyMode}" selectionChange=".onFKeyModeChange">
                            <items>
                                <SegmentedButtonItem key="Virtual" text="Virtual" />
                                <SegmentedButtonItem key="Native" text="Native" />
                            </items>
                        </SegmentedButton>
                    </HBox>
                </VBox>
            </Panel>

            <Panel class="sapUiSmallMarginBottom" headerText="Docked Keyboard (tap any input)">
                <VBox class="sapUiSmallMargin">
                    <Text text="Tap an input field below. The keyboard slides up and auto-detects numpad for Number/Tel inputs." />
                    <Label text="Full Name" labelFor="nameInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="nameInput"
                        placeholder="John Doe"
                        width="100%" />
                    <Label text="Email" labelFor="emailInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="emailInput"
                        placeholder="john@example.com"
                        width="100%" />
                    <Label text="Age" labelFor="ageInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="ageInput"
                        type="Number"
                        placeholder="25"
                        width="100%" />
                    <Label text="Phone" labelFor="phoneInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="phoneInput"
                        type="Tel"
                        placeholder="+49 123 456789"
                        width="100%" />
                    <Label text="Notes" labelFor="notesInput" class="sapUiSmallMarginTop" />
                    <TextArea
                        id="notesInput"
                        placeholder="Additional notes..."
                        rows="3"
                        width="100%" />
                </VBox>
            </Panel>

            <Panel class="sapUiSmallMarginBottom" headerText="Inline Numpad">
                <VBox class="sapUiSmallMargin">
                    <Text text="A compact numeric keypad rendered inline (not docked)." />
                    <Input
                        id="numpadInput"
                        placeholder="Numeric input..."
                        class="sapUiSmallMarginTop"
                        width="12rem" />
                    <kiosk:KioskKeyboard
                        id="numpadKeyboard"
                        keyboardType="Numpad"
                        targetInput="numpadInput"
                        ariaLabel="Numeric Keypad"
                        class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

            <Panel class="sapUiSmallMarginBottom" headerText="Event Log">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/kioskLastKey}" state="Information" />
                    </HBox>
                    <HBox>
                        <Label text="Active Layout:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/kioskLayout}" state="Success" />
                    </HBox>
                    <HBox>
                        <Label text="F-Key Mode:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/kioskFKeyMode}" state="Information" />
                    </HBox>
                </VBox>
            </Panel>

            <kiosk:KioskKeyboard
                id="dockedKeyboard"
                docked="true"
                autoShow="true"
                autoType="true"
                enabled="{state>/kioskEnabled}"
                fKeyMode="{state>/kioskFKeyMode}"
                keyPress=".onKeyPress"
                layoutChange=".onDockedLayoutChange" />
        </content>
    </Page>
</mvc:View>
