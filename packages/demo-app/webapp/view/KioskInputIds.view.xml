<mvc:View
    controllerName="demo.hotkeys.controller.KioskInputIds"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:custom="demo/hotkeys/control"
    xmlns:webc="@ui5/webcomponents/dist"
    xmlns:kiosk="ui5.kiosk">
    <Page title="Input IDs Targeting Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <content>
            <Panel headerText="Status" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="Keyboard Type:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/kioskKeyboardType}" state="Success" />
                    </HBox>
                    <HBox>
                        <Label text="Current Target:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/kioskCurrentTarget}" state="Information" />
                    </HBox>
                    <HBox>
                        <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/kioskLastKey}" state="Information" />
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="Selective Input Targeting" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <MessageStrip
                        text="The keyboard targets inputs A, B, StepInput, and the Web Component inputs via inputIds. Focusing C or D does not switch the target. Toggle autoType to switch automatically to Numpad for StepInput and back to Full for text inputs."
                        type="Information"
                        showIcon="true" />
                    <HBox class="sapUiSmallMarginTop">
                        <VBox class="sapUiMediumMarginEnd">
                            <HBox>
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Input A (targeted)" labelFor="inputA" />
                                    <Input id="inputA" placeholder="Targeted by keyboard" />
                                </VBox>
                                <VBox>
                                    <Label text="Input B (targeted)" labelFor="inputB" />
                                    <Input id="inputB" placeholder="Targeted by keyboard" />
                                </VBox>
                            </HBox>
                            <HBox class="sapUiSmallMarginTop">
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Input C (not targeted)" labelFor="inputC" />
                                    <Input id="inputC" placeholder="Not targeted" />
                                </VBox>
                                <VBox>
                                    <Label text="Input D (not targeted)" labelFor="inputD" />
                                    <Input id="inputD" placeholder="Not targeted" />
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox>
                            <HBox>
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="UI5 Web Component (targeted)" labelFor="ui5WebcInput" />
                                    <webc:Input id="ui5WebcInput" valueState="None" placeholder="UI5 Web Component Input" />
                                </VBox>
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Custom Web Component (targeted)" labelFor="wcInputTarget" />
                                    <custom:KioskInput id="wcInputTarget" placeholder="Custom element input" />
                                </VBox>
                                <VBox>
                                    <Label text="Native custom element" />
                                    <custom:AlertButton
                                        text="Native Custom Element"
                                        message="Hello from demo-alert-button (native custom element in XML view)!"
                                        demoAlert=".onDemoAlert" />
                                </VBox>
                            </HBox>
                            <HBox alignItems="Center" class="sapUiSmallMarginTop">
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="StepInput (targeted)" labelFor="stepInputTarget" />
                                    <StepInput id="stepInputTarget" width="12rem" min="0" max="999" value="5" />
                                </VBox>
                                <HBox alignItems="Center">
                                    <Label text="autoType:" class="sapUiSmallMarginEnd" />
                                    <Switch state="{state>/kioskAutoType}" />
                                </HBox>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
            </Panel>

            <kiosk:KioskKeyboard
                id="inputIdsKeyboard"
                docked="true"
                autoShow="true"
                autoType="{state>/kioskAutoType}"
                inputIds="inputA,inputB,stepInputTarget,ui5WebcInput,wcInputTarget"
                keyPress=".onKeyPress"
                keyboardTypeChange=".onKeyboardTypeChange"
                ariaLabel="Selective Keyboard" />
        </content>
    </Page>
</mvc:View>
