<mvc:View
    controllerName="demo.hotkeys.controller.KioskInputIds"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:custom="demo/hotkeys/control"
    xmlns:webc="@ui5/webcomponents/dist"
    xmlns:kiosk="ui5.kiosk">
    <Page title="Input IDs Targeting Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <content>
            <Panel headerText="Selective Input Targeting" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="The keyboard below targets Input A, Input B, StepInput, a native UI5 Web Component input, and a custom Web Component input directly via inputIds. Focusing Input C or D will not switch the keyboard target." />
                    <Panel headerText="Web Component Inputs" class="sapUiTinyMarginTop sapUiNoContentPadding">
                        <VBox class="sapUiSmallMargin">
                            <Label text="Native custom-element consumption in UI5 XML (WebComponent wrapper control)" />
                            <custom:AlertButton
                                text="Native Custom Element"
                                message="Hello from demo-alert-button (native custom element in XML view)!"
                                demoAlert=".onDemoAlert" />
                            <Label text="UI5 Web Component input (targeted directly)" labelFor="ui5WebcInput" class="sapUiSmallMarginTop" />
                            <webc:Input id="ui5WebcInput" valueState="None" placeholder="UI5 Web Component Input" />
                            <Label text="Custom Web Component input (targeted directly)" labelFor="wcInputTarget" class="sapUiSmallMarginTop" />
                            <custom:KioskInput id="wcInputTarget" placeholder="Custom element input" />
                        </VBox>
                    </Panel>
                    <Label text="Input A (targeted)" labelFor="inputA" class="sapUiSmallMarginTop" />
                    <Input id="inputA" placeholder="Targeted by keyboard" width="100%" />
                    <Label text="Input B (targeted)" labelFor="inputB" class="sapUiSmallMarginTop" />
                    <Input id="inputB" placeholder="Targeted by keyboard" width="100%" />
                    <Label text="StepInput (targeted)" labelFor="stepInputTarget" class="sapUiSmallMarginTop" />
                    <StepInput id="stepInputTarget" width="12rem" min="0" max="999" value="5" />
                    <Label text="Input C (not targeted)" labelFor="inputC" class="sapUiSmallMarginTop" />
                    <Input id="inputC" placeholder="Not targeted" width="100%" />
                    <Label text="Input D (not targeted)" labelFor="inputD" class="sapUiSmallMarginTop" />
                    <Input id="inputD" placeholder="Not targeted" width="100%" />
                </VBox>
            </Panel>

            <Panel headerText="Status" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="Current Target:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/kioskCurrentTarget}" state="Information" />
                    </HBox>
                    <HBox>
                        <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/kioskLastKey}" state="Information" />
                    </HBox>
                </VBox>
            </Panel>

            <kiosk:KioskKeyboard
                id="inputIdsKeyboard"
                docked="true"
                autoShow="true"
                inputIds="inputA,inputB,stepInputTarget,ui5WebcInput,wcInputTarget"
                keyPress=".onKeyPress"
                ariaLabel="Selective Keyboard" />
        </content>
    </Page>
</mvc:View>
