<mvc:View
    controllerName="demo.hotkeys.controller.KioskDialog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:kiosk="ui5.kiosk">
    <Page titleAlignment="Center" title="Dialog Integration Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding demoDockedPage">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo rootRole="None" headerRole="Banner" />
        </landmarkInfo>
        <content>
            <HBox class="sapUiSmallMarginBottom" gap="1rem" wrap="Wrap">
                <Panel headerText="Page Input (Docked Keyboard)">
                    <layoutData>
                        <FlexItemData growFactor="1" baseSize="18rem" />
                    </layoutData>
                    <VBox class="sapUiSmallMargin">
                        <Text text="Tap the input below to open the docked keyboard. Whether it stays open once a dialog opens depends on the approach: it closes for A, because focus leaves the page input, and stays for C, whose dialog input it also targets." />
                        <Label text="Page Input" labelFor="pageInput" class="sapUiSmallMarginTop" />
                        <Input
                            id="pageInput"
                            placeholder="Type here..."
                            width="100%" />
                    </VBox>
                </Panel>
                <Panel headerText="Status">
                    <layoutData>
                        <FlexItemData growFactor="1" baseSize="18rem" />
                    </layoutData>
                    <VBox class="sapUiSmallMargin">
                        <HBox>
                            <Label text="Docked Keyboard Open:" class="sapUiSmallMarginEnd" />
                            <ObjectStatus text="{state>/dialogDockedOpen}" state="Information" />
                        </HBox>
                        <HBox>
                            <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                            <ObjectStatus text="{state>/dialogLastKey}" state="Information" />
                        </HBox>
                    </VBox>
                </Panel>
            </HBox>

            <Panel headerText="Dialog Approaches" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Button
                        text="Approach A: Dialog without Keyboard"
                        press=".onOpenDialogA"
                        class="sapUiSmallMarginBottom" />
                    <Text text="Plain dialog with an input. Docked keyboard auto-closes. On dialog close, page input is re-focused so keyboard resumes." />
                    <Button
                        text="Approach B: Dialog with Embedded Keyboard"
                        press=".onOpenDialogB"
                        class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
                    <Text text="Dialog with its own inline KioskKeyboard targeting the dialog input." />
                    <Button
                        text="Approach C: Dialog with Docked Keyboard"
                        press=".onOpenDialogC"
                        class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
                    <Text text="The page's docked keyboard stays open, renders above the dialog, and types into the dialog input. On dialog close, it returns to the page input." />
                </VBox>
            </Panel>
        </content>
    </Page>

    <!-- A sibling of the Page, not its content: sap.m.Page is a stacking context
         (isolation: isolate), so a docked keyboard inside it could never paint
         above a dialog's block layer, whatever its z-index. -->
    <kiosk:KioskKeyboard
        id="dialogDockedKeyboard"
        docked="true"
        autoShow="true"
        controls="pageInput,dialogCInput"
        keyPress=".onKeyPress"
        afterOpen=".onDockedAfterOpen"
        afterClose=".onDockedAfterClose"
        ariaLabel="Page Keyboard" />
</mvc:View>
