<mvc:View
    controllerName="demo.hotkeys.controller.HotkeysHub"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page titleAlignment="Center" title="Hotkey Manager Demos" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo rootRole="None" headerRole="Banner" />
        </landmarkInfo>
        <content>
            <List
                headerText="Choose a Scenario"
                items="{state>/hotkeysDemoEntries}"
                itemPress=".onListEntryNavigate">
                <StandardListItem
                    title="{state>title}"
                    description="{state>description}"
                    type="Navigation" />
            </List>
        </content>
    </Page>
</mvc:View>
