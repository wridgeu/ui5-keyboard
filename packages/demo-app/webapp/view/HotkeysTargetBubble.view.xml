<mvc:View
    controllerName="demo.hotkeys.controller.HotkeysTargetBubble"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="targetBubblePage" title="Hotkeys Demo - Target Bubbling" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <content>
            <HBox fitContainer="true" renderType="Bare">
                <VBox class="sapUiSmallMarginEnd">
                    <layoutData>
                        <FlexItemData growFactor="1" />
                    </layoutData>
                    <Panel headerText="Scenario" class="sapUiSmallMarginBottom">
                        <VBox class="sapUiSmallMargin">
                            <Text text="Two nested target registrations use the same key (Escape). The innermost matching target fires." />
                            <MessageStrip
                                text="Pressing Escape repeatedly will eventually resolve to 'outside nested target' because UI5 releases focus from the input after the first Escape, so subsequent presses no longer originate inside the inner target."
                                type="Information"
                                showIcon="true"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </Panel>

                    <Panel headerText="Nested Targets">
                        <VBox class="sapUiSmallMargin">
                            <VBox id="outerTargetBox" class="sapUiContentPadding sapUiSmallMarginBottom">
                                <Text text="Outer target" />
                                <VBox id="innerTargetBox" class="sapUiContentPadding sapUiSmallMarginTop">
                                    <Text text="Inner target" />
                                    <Input id="bubbleInput" placeholder="Focus here and press Escape" class="sapUiSmallMarginTop"
                                        ariaLabelledBy="bubbleInputLabel" />
                                    <core:InvisibleText id="bubbleInputLabel" text="Input for target bubbling scenario" />
                                </VBox>
                            </VBox>
                        </VBox>
                    </Panel>
                </VBox>

                <!-- Live event log -->
                <Panel>
                    <layoutData>
                        <FlexItemData growFactor="1" baseSize="20rem" />
                    </layoutData>
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Event Log" />
                            <ToolbarSpacer />
                            <Button icon="sap-icon://delete" tooltip="Clear log" press=".onClearLog" type="Transparent" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <ScrollContainer height="60vh" vertical="true">
                        <List
                            id="bubbleLogList"
                            items="{bubbleLog>/entries}"
                            noDataText="Focus the inner input and press Escape.">
                            <StandardListItem
                                title="{bubbleLog>event}"
                                description="{bubbleLog>detail}"
                                info="{bubbleLog>time}"
                                infoState="{bubbleLog>state}"
                                type="Inactive" />
                        </List>
                    </ScrollContainer>
                </Panel>
            </HBox>
        </content>
    </Page>
</mvc:View>
