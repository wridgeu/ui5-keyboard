<mvc:View
    controllerName="demo.hotkeys.controller.HotkeysTargetBubble"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="targetBubblePage" titleAlignment="Center" title="Hotkeys Demo - Target Bubbling" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo rootRole="None" headerRole="Banner" />
        </landmarkInfo>
        <content>
            <HBox fitContainer="true" renderType="Bare" wrap="Wrap" gap="1rem">
                <VBox>
                    <layoutData>
                        <FlexItemData growFactor="1" baseSize="20rem" />
                    </layoutData>
                    <Panel headerText="Scenario" class="sapUiSmallMarginBottom">
                        <VBox class="sapUiSmallMargin">
                            <Text text="Two nested target registrations use the same key (Escape). The innermost target around the focused element fires and stops the key there." />
                            <MessageStrip
                                text="Escape in the input fires the inner target. Escape on the button, which sits in the outer target but outside the inner one, fires the outer target. Escape anywhere else on the page falls through to the route-wide registration ('outside nested target'). The first Escape within about a second (1.2s) of focus leaving the button or input still fires that element's target, because the focus fallback remembers the last focused element briefly after a blur."
                                type="Information"
                                showIcon="true"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </Panel>

                    <Panel headerText="Nested Targets">
                        <VBox class="sapUiSmallMargin">
                            <VBox id="outerTargetBox" class="sapUiContentPadding sapUiSmallMarginBottom">
                                <Text text="Outer target" />
                                <Button id="outerTargetButton" text="Focus me and press Escape" class="sapUiSmallMarginTop" />
                                <VBox id="innerTargetBox" class="sapUiContentPadding sapUiSmallMarginTop">
                                    <Text text="Inner target" />
                                    <Input id="bubbleInput" placeholder="Focus here and press Escape" class="sapUiSmallMarginTop"
                                        ariaLabelledBy="bubbleInputLabel" />
                                    <core:InvisibleText id="bubbleInputLabel" text="Input for target bubbling scenario" />
                                </VBox>
                            </VBox>
                        </VBox>
                    </Panel>
                </VBox>

                <!-- Live event log -->
                <Panel>
                    <layoutData>
                        <FlexItemData growFactor="1" baseSize="20rem" shrinkFactor="0" />
                    </layoutData>
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title id="bubbleLogTitle" text="Event Log" />
                            <ToolbarSpacer />
                            <Button icon="sap-icon://delete" tooltip="Clear log" press=".onClearLog" type="Transparent" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <ScrollContainer height="60vh" vertical="true">
                        <List
                            id="bubbleLogList"
                            ariaLabelledBy="bubbleLogTitle"
                            items="{bubbleLog>/entries}"
                            noDataText="Focus the input or the button and press Escape.">
                            <StandardListItem
                                title="{bubbleLog>event}"
                                description="{bubbleLog>detail}"
                                info="{bubbleLog>time}"
                                infoState="{bubbleLog>state}"
                                type="Inactive" />
                        </List>
                    </ScrollContainer>
                </Panel>
            </HBox>
        </content>
    </Page>
</mvc:View>
