<mvc:View
    controllerName="demo.hotkeys.controller.KioskFormWorkflow"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:kiosk="ui5.kiosk">
    <Page titleAlignment="Center" title="Form Workflow Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding demoDockedPage">
        <content>
            <Panel headerText="Status" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="Active Field:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/formActiveField}" state="Information" />
                    </HBox>
                    <HBox>
                        <Label text="Keyboard Type:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/formKeyboardType}" state="Success" />
                    </HBox>
                    <HBox>
                        <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/formLastKey}" state="Information" />
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="Self-Service Check-In" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="Tap a field to begin. Press Enter on the keyboard to advance to the next field. The keyboard auto-switches between Full and Numpad based on input type." />
                    <ProgressIndicator
                        percentValue="{state>/formProgress}"
                        displayValue="{state>/formProgressText}"
                        state="Information"
                        class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
                    <Label text="Full Name *" labelFor="nameInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="nameInput"
                        placeholder="John Doe"
                        width="100%"
                        liveChange=".onFieldChange" />
                    <Label text="Email *" labelFor="emailInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="emailInput"
                        type="Email"
                        placeholder="john@example.com"
                        width="100%"
                        liveChange=".onFieldChange" />
                    <Label text="Phone" labelFor="phoneInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="phoneInput"
                        type="Tel"
                        placeholder="+49 123 456789"
                        width="100%"
                        liveChange=".onFieldChange" />
                    <Label text="Number of Guests" labelFor="guestsInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="guestsInput"
                        type="Number"
                        placeholder="1"
                        width="100%"
                        liveChange=".onFieldChange" />
                    <Label text="Notes" labelFor="notesInput" class="sapUiSmallMarginTop" />
                    <TextArea
                        id="notesInput"
                        placeholder="Additional notes..."
                        rows="3"
                        width="100%"
                        liveChange=".onFieldChange" />
                    <Button
                        id="submitBtn"
                        text="Submit Check-In"
                        type="Emphasized"
                        press=".onSubmit"
                        class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

            <kiosk:KioskKeyboard
                id="formKeyboard"
                docked="true"
                autoShow="true"
                autoType="true"
                inputIds="nameInput,emailInput,phoneInput,guestsInput,notesInput"
                keyPress=".onKeyPress"
                keyboardTypeChange=".onKeyboardTypeChange"
                afterOpen=".onAfterOpen" />
        </content>
    </Page>
</mvc:View>
