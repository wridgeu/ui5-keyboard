<mvc:View
    controllerName="demo.hotkeys.controller.KioskPopover"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page titleAlignment="Center" title="Popover Keyboard Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <content>
            <Panel headerText="A) Generous container (19 rem)" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="contentHeight='19rem' gives the full-size keyboard enough room. Slightly more empty space when the numeric layout is active, but no scrollbar." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Full Name" class="sapUiSmallMarginEnd" />
                        <Input id="inputA" placeholder="Jane Doe" width="14rem" />
                        <Button
                            icon="sap-icon://keyboard-and-mouse"
                            type="Transparent"
                            press=".onOpenKeyboardA"
                            ariaHasPopup="Dialog">
                            <customData>
                                <core:CustomData key="inputId" value="inputA" />
                            </customData>
                        </Button>
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="B) Compact container (16 rem)" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="contentHeight='16rem' triggers the cq-short breakpoint. The keyboard automatically reduces key height to 2.25 rem and fits without a scrollbar." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Full Name" class="sapUiSmallMarginEnd" />
                        <Input id="inputB" placeholder="Jane Doe" width="14rem" />
                        <Button
                            icon="sap-icon://keyboard-and-mouse"
                            type="Transparent"
                            press=".onOpenKeyboardB"
                            ariaHasPopup="Dialog">
                            <customData>
                                <core:CustomData key="inputId" value="inputB" />
                            </customData>
                        </Button>
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="C) Height on the keyboard element" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="No contentHeight on the Popover. Instead, the keyboard element itself gets a fixed height (18 rem) via addStyleClass. The Popover sizes to its content and never scrolls." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Full Name" class="sapUiSmallMarginEnd" />
                        <Input id="inputC" placeholder="Jane Doe" width="14rem" />
                        <Button
                            icon="sap-icon://keyboard-and-mouse"
                            type="Transparent"
                            press=".onOpenKeyboardC"
                            ariaHasPopup="Dialog">
                            <customData>
                                <core:CustomData key="inputId" value="inputC" />
                            </customData>
                        </Button>
                    </HBox>
                </VBox>
            </Panel>
        </content>
    </Page>
</mvc:View>
