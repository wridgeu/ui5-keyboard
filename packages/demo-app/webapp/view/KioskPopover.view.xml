<mvc:View
    controllerName="demo.hotkeys.controller.KioskPopover"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page titleAlignment="Center" title="Popover Keyboard Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo rootRole="None" headerRole="Banner" />
        </landmarkInfo>
        <content>
            <Panel headerText="A) Generous height (19 rem)" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="The keyboard element gets height: 19rem via a CSS class. Full-size keys fit comfortably with no responsive breakpoints triggered." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Full Name (generous height)" labelFor="inputA" class="sapUiSmallMarginEnd" />
                        <Input id="inputA" placeholder="Jane Doe" width="14rem" />
                        <Button
                            icon="sap-icon://keyboard-and-mouse"
                            tooltip="Open keyboard for Full Name (generous height)"
                            type="Transparent"
                            press=".onOpenKeyboardA"
                            ariaHasPopup="Dialog">
                            <customData>
                                <core:CustomData key="inputId" value="inputA" />
                            </customData>
                        </Button>
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="B) Compact height (15 rem)" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="The keyboard element gets height: 15rem. This triggers the cqShort breakpoint and the keyboard automatically reduces key height to fit." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Full Name (compact height)" labelFor="inputB" class="sapUiSmallMarginEnd" />
                        <Input id="inputB" placeholder="Jane Doe" width="14rem" />
                        <Button
                            icon="sap-icon://keyboard-and-mouse"
                            tooltip="Open keyboard for Full Name (compact height)"
                            type="Transparent"
                            press=".onOpenKeyboardB"
                            ariaHasPopup="Dialog">
                            <customData>
                                <core:CustomData key="inputId" value="inputB" />
                            </customData>
                        </Button>
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="C) Custom CSS variables" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="Instead of constraining the height, reduce --ui5KioskKeyboard-keyHeight and --ui5KioskKeyboard-keyGap so the keyboard naturally fits in a smaller space." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Full Name (custom CSS variables)" labelFor="inputC" class="sapUiSmallMarginEnd" />
                        <Input id="inputC" placeholder="Jane Doe" width="14rem" />
                        <Button
                            icon="sap-icon://keyboard-and-mouse"
                            tooltip="Open keyboard for Full Name (custom CSS variables)"
                            type="Transparent"
                            press=".onOpenKeyboardC"
                            ariaHasPopup="Dialog">
                            <customData>
                                <core:CustomData key="inputId" value="inputC" />
                            </customData>
                        </Button>
                    </HBox>
                </VBox>
            </Panel>
            <Panel headerText="D) Borderless (blends with popover)" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="Remove the keyboard container border via --ui5KioskKeyboard-border: none so the keyboard blends seamlessly into the popover chrome." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Full Name (borderless)" labelFor="inputD" class="sapUiSmallMarginEnd" />
                        <Input id="inputD" placeholder="Jane Doe" width="14rem" />
                        <Button
                            icon="sap-icon://keyboard-and-mouse"
                            tooltip="Open keyboard for Full Name (borderless)"
                            type="Transparent"
                            press=".onOpenKeyboardD"
                            ariaHasPopup="Dialog">
                            <customData>
                                <core:CustomData key="inputId" value="inputD" />
                            </customData>
                        </Button>
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="E) Popover contentHeight (no keyboard CSS)" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="The Popover has contentHeight: 15rem but no CSS on the keyboard. The Popover's intermediate wrapper divs have height: auto, so max-height: 100% cannot propagate. The keyboard renders at full size and overflows, demonstrating the limitation documented in the README." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Full Name (popover contentHeight)" labelFor="inputE" class="sapUiSmallMarginEnd" />
                        <Input id="inputE" placeholder="Jane Doe" width="14rem" />
                        <Button
                            icon="sap-icon://keyboard-and-mouse"
                            tooltip="Open keyboard for Full Name (popover contentHeight)"
                            type="Transparent"
                            press=".onOpenKeyboardE"
                            ariaHasPopup="Dialog">
                            <customData>
                                <core:CustomData key="inputId" value="inputE" />
                            </customData>
                        </Button>
                    </HBox>
                </VBox>
            </Panel>
        </content>
    </Page>
</mvc:View>
