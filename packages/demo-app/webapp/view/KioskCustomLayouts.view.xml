<mvc:View
    controllerName="demo.hotkeys.controller.KioskCustomLayouts"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:kiosk="ui5.kiosk"
    xmlns:demo="demo.hotkeys.customlayout">
    <Page titleAlignment="Center" title="Custom Layouts Gallery" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo rootRole="None" headerRole="Banner" />
        </landmarkInfo>
        <content>
            <HBox class="sapUiSmallMarginBottom" gap="1rem">
                <Panel headerText="Layout Switcher">
                    <VBox class="sapUiSmallMargin">
                        <Text text="Five layouts are declared on the keyboard as &lt;kiosk:CustomLayout&gt; child elements, with no controller code configuring them. They demonstrate KeyDefinition options such as width, type, icon, unicode values, label overrides, and dual icon+label rendering. The Arabic pad ships as its own element, &lt;demo:ArabicDigitsCustomLayout&gt;, carrying its rows and keycap language together." />
                        <HBox class="sapUiSmallMarginTop" wrap="Wrap">
                            <Button
                                text="Emoji Picker"
                                press=".onUseEmoji"
                                type="{= ${state>/customActiveLayout} === 'emoji' ? 'Emphasized' : 'Default'}"
                                class="sapUiSmallMarginEnd" />
                            <Button
                                text="IP Address Pad"
                                press=".onUseIpAddress"
                                type="{= ${state>/customActiveLayout} === 'ip-address' ? 'Emphasized' : 'Default'}"
                                class="sapUiSmallMarginEnd" />
                            <Button
                                text="Currency Pad"
                                press=".onUseCurrency"
                                type="{= ${state>/customActiveLayout} === 'currency' ? 'Emphasized' : 'Default'}"
                                class="sapUiSmallMarginEnd" />
                            <Button
                                text="Icon + Label"
                                press=".onUseIconLabel"
                                type="{= ${state>/customActiveLayout} === 'icon-label' ? 'Emphasized' : 'Default'}"
                                class="sapUiSmallMarginEnd" />
                            <Button
                                text="Arabic Digits"
                                press=".onUseArabicDigits"
                                type="{= ${state>/customActiveLayout} === 'arabic-digits' ? 'Emphasized' : 'Default'}" />
                        </HBox>
                    </VBox>
                </Panel>
                <Panel headerText="Status">
                    <VBox class="sapUiSmallMargin">
                        <HBox>
                            <Label text="Active Layout:" class="sapUiSmallMarginEnd" />
                            <ObjectStatus text="{state>/customActiveLayout}" state="Success" />
                        </HBox>
                        <HBox>
                            <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                            <ObjectStatus text="{state>/customLastKey}" state="Information" />
                        </HBox>
                        <HBox>
                            <Label text="Description:" class="sapUiSmallMarginEnd" />
                            <Text text="{state>/customDescription}" />
                        </HBox>
                    </VBox>
                </Panel>
            </HBox>

            <Panel headerText="Target Input" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Label text="Input Field" labelFor="customInput" />
                    <Input id="customInput" placeholder="Type here..." width="100%" />
                </VBox>
            </Panel>

            <Panel headerText="Variant Tiers" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="Long-press a key (or right-click) to see the accent popup. Variants resolve in three tiers, each merged onto the one below per base letter: the built-in Latin table, the keyboard's defaultVariants house set, then whatever the layout's own CustomLayout declares. QWERTY overlays the built-in with Polish accents; QWERTZ suppresses the facet entirely." />
                    <HBox class="sapUiSmallMarginTop" wrap="Wrap">
                        <Button
                            text="QWERTY (built-in + house + own)"
                            press=".onUseVariantQwerty"
                            type="{= ${state>/variantLayout} === 'qwerty' ? 'Emphasized' : 'Default'}"
                            class="sapUiSmallMarginEnd" />
                        <Button
                            text="QWERTZ (suppress=&quot;Variants&quot;)"
                            press=".onUseVariantQwertz"
                            type="{= ${state>/variantLayout} === 'qwertz-de' ? 'Emphasized' : 'Default'}" />
                    </HBox>
                    <Label text="Variant Input" labelFor="variantInput" class="sapUiSmallMarginTop" />
                    <Input id="variantInput" placeholder="Long-press a, q or s..." width="100%" />
                    <kiosk:KioskKeyboard
                        id="variantKeyboard"
                        controls="variantInput"
                        accentVariants="true"
                        defaultVariants="{layouts>/houseAccents}"
                        ariaLabel="Variant Tier Keyboard"
                        class="sapUiSmallMarginTop">
                        <kiosk:customLayouts>
                            <!-- Rows-less overlay: the built-in qwerty keeps its keys and gains these accents. -->
                            <kiosk:CustomLayout name="qwerty" variants="{layouts>/polishAccents}" />
                            <!-- The opt-out: this layout takes no long-press affordance at all. -->
                            <kiosk:CustomLayout name="qwertz-de" suppress="Variants" />
                        </kiosk:customLayouts>
                    </kiosk:KioskKeyboard>
                </VBox>
            </Panel>

            <Panel headerText="Keyboard" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <kiosk:KioskKeyboard
                        id="customKeyboard"
                        controls="customInput"
                        keyPress=".onKeyPress"
                        ariaLabel="Custom Layout Keyboard">
                        <kiosk:customLayouts>
                            <kiosk:CustomLayout name="emoji" rows="{layouts>/emoji}" />
                            <kiosk:CustomLayout name="ip-address" rows="{layouts>/ipAddress}" />
                            <kiosk:CustomLayout name="currency" rows="{layouts>/currency}" />
                            <kiosk:CustomLayout name="icon-label" rows="{layouts>/iconLabel}" />
                            <demo:ArabicDigitsCustomLayout />
                        </kiosk:customLayouts>
                    </kiosk:KioskKeyboard>
                </VBox>
            </Panel>
        </content>
    </Page>
</mvc:View>
