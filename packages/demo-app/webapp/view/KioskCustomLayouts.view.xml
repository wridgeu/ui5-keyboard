<mvc:View
    controllerName="demo.hotkeys.controller.KioskCustomLayouts"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:kiosk="ui5.kiosk">
    <Page titleAlignment="Center" title="Custom Layouts Gallery" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <content>
            <HBox class="sapUiSmallMarginBottom" gap="1rem">
                <Panel headerText="Layout Switcher">
                    <VBox class="sapUiSmallMargin">
                        <Text text="Four custom LayoutDefinitions are supplied to the keyboard via the instanceLayouts property. They demonstrate KeyDefinition options such as width, type, icon, unicode values, label overrides, and dual icon+label rendering." />
                        <HBox class="sapUiSmallMarginTop">
                            <Button
                                text="Emoji Picker"
                                press=".onUseEmoji"
                                type="{= ${state>/customActiveLayout} === 'emoji' ? 'Emphasized' : 'Default'}"
                                class="sapUiSmallMarginEnd" />
                            <Button
                                text="IP Address Pad"
                                press=".onUseIpAddress"
                                type="{= ${state>/customActiveLayout} === 'ip-address' ? 'Emphasized' : 'Default'}"
                                class="sapUiSmallMarginEnd" />
                            <Button
                                text="Currency Pad"
                                press=".onUseCurrency"
                                type="{= ${state>/customActiveLayout} === 'currency' ? 'Emphasized' : 'Default'}"
                                class="sapUiSmallMarginEnd" />
                            <Button
                                text="Icon + Label"
                                press=".onUseIconLabel"
                                type="{= ${state>/customActiveLayout} === 'icon-label' ? 'Emphasized' : 'Default'}" />
                        </HBox>
                    </VBox>
                </Panel>
                <Panel headerText="Status">
                    <VBox class="sapUiSmallMargin">
                        <HBox>
                            <Label text="Active Layout:" class="sapUiSmallMarginEnd" />
                            <ObjectStatus text="{state>/customActiveLayout}" state="Success" />
                        </HBox>
                        <HBox>
                            <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                            <ObjectStatus text="{state>/customLastKey}" state="Information" />
                        </HBox>
                        <HBox>
                            <Label text="Description:" class="sapUiSmallMarginEnd" />
                            <Text text="{state>/customDescription}" />
                        </HBox>
                    </VBox>
                </Panel>
            </HBox>

            <Panel headerText="Target Input" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Input id="customInput" placeholder="Type here..." width="100%" />
                </VBox>
            </Panel>

            <Panel headerText="Keyboard" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <kiosk:KioskKeyboard
                        id="customKeyboard"
                        controls="customInput"
                        keyPress=".onKeyPress"
                        ariaLabel="Custom Layout Keyboard" />
                </VBox>
            </Panel>
        </content>
    </Page>
</mvc:View>
