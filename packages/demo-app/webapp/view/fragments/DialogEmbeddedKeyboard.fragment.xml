<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:kiosk="ui5.kiosk">
    <Dialog
        title="Approach B: Embedded Keyboard"
        contentWidth="30rem"
        afterClose=".onDialogAfterClose">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Dialog Input" />
                <Input id="dialogBInput" placeholder="Type in dialog..." width="100%" />
                <kiosk:KioskKeyboard controls="dialogBInput" ariaLabel="Dialog Keyboard" />
            </VBox>
        </content>
        <beginButton>
            <Button text="Close" press=".onCloseDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
