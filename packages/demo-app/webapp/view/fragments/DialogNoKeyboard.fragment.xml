<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        title="Approach A: No Keyboard"
        afterClose=".onDialogAfterClose">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Dialog Input" />
                <Input placeholder="Type in dialog..." width="100%" />
            </VBox>
        </content>
        <beginButton>
            <Button text="Close" press=".onCloseDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
