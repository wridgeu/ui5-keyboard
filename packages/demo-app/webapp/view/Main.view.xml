<mvc:View
    controllerName="demo.hotkeys.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="UI5 Keyboard Libraries Demo" id="mainPage" class="sapUiContentPadding">
        <content>
            <Panel headerText="Welcome" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="Explore two keyboard-focused libraries for UI5 applications:" />
                    <Text text="- ui5.hotkeys: scoped hotkey management, sequences, target-scoped matching" />
                    <Text text="- ui5.kiosk: virtual keyboard flows for touch and kiosk environments" />
                </VBox>
            </Panel>

            <List
                headerText="Choose a Demo Area"
                items="{state>/mainDemoEntries}"
                itemPress=".onMainEntryPress">
                <StandardListItem
                    title="{state>title}"
                    description="{state>description}"
                    type="Navigation" />
            </List>
        </content>
    </Page>
</mvc:View>
