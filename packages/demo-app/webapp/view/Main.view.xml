<mvc:View
    controllerName="demo.hotkeys.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="ui5.hotkeys Demo — Main View" id="mainPage">
        <headerContent>
            <Button text="Navigate to Detail" press=".onNavToDetail" type="Emphasized" />
            <Button text="Kiosk Keyboard" press=".onNavToKiosk" />
        </headerContent>
        <content>
            <Panel headerText="Status" class="sapUiMediumMargin">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="Platform:" class="sapUiSmallMarginEnd" />
                        <Text text="{state>/platform}" />
                    </HBox>
                    <HBox>
                        <Label text="Active Scope:" class="sapUiSmallMarginEnd" />
                        <Text text="{state>/activeScope}" />
                    </HBox>
                    <HBox>
                        <Label text="Last Action:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/lastAction}" state="Information" />
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="Registered Shortcuts" class="sapUiMediumMargin">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="{state>/saveLabel}" class="sapUiSmallMarginEnd" design="Bold" />
                        <Text text="Save (global — works in inputs too)" />
                    </HBox>
                    <HBox>
                        <Label text="{state>/escapeLabel}" class="sapUiSmallMarginEnd" design="Bold" />
                        <Text text="Cancel / Close (global — works in inputs too)" />
                    </HBox>
                    <HBox>
                        <Label text="{state>/f5Label}" class="sapUiSmallMarginEnd" design="Bold" />
                        <Text text="Refresh (Main view scope — overrides browser refresh)" />
                    </HBox>
                    <HBox>
                        <Label text="{state>/navLabel}" class="sapUiSmallMarginEnd" design="Bold" />
                        <Text text="Navigate to Detail (Main view scope)" />
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="Input Field Test" class="sapUiMediumMargin">
                <VBox class="sapUiSmallMargin">
                    <Text text="Type in the field below. Single-key shortcuts are suppressed, but Ctrl/Cmd combos still work." />
                    <Input id="testInput" placeholder="Try typing, then press Ctrl+S or Escape..." class="sapUiSmallMarginTop"
                        ariaLabelledBy="testInputLabel" />
                    <core:InvisibleText id="testInputLabel" text="Test input for keyboard shortcuts" xmlns:core="sap.ui.core" />
                </VBox>
            </Panel>

            <Panel headerText="Dialog Test" class="sapUiMediumMargin">
                <VBox class="sapUiSmallMargin">
                    <Text text="Open a dialog to test scope switching. The dialog registers its own F5 handler." />
                    <Button text="Open Dialog" press=".onOpenDialog" type="Emphasized" class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

            <Panel headerText="Key Sequences (SequenceManager)" class="sapUiMediumMargin">
                <VBox class="sapUiSmallMargin">
                    <Text text="Multi-key sequences (like Vim's g-commands). Press the first key, then the second within the timeout." />
                    <HBox class="sapUiSmallMarginTop">
                        <Label text="G I" class="sapUiSmallMarginEnd" design="Bold" />
                        <Text text="Navigate to Detail (sequence)" />
                    </HBox>
                    <HBox>
                        <Label text="G S" class="sapUiSmallMarginEnd" design="Bold" />
                        <Text text="Go to Settings (sequence)" />
                    </HBox>
                    <ObjectStatus text="{state>/sequenceStatus}" state="Warning" class="sapUiSmallMarginTop"
                        visible="{= ${state>/sequenceStatus} !== '' }" />
                </VBox>
            </Panel>

            <Panel headerText="Held Keys (KeyStateTracker)" class="sapUiMediumMargin">
                <VBox class="sapUiSmallMargin">
                    <Text text="Shows which keys are physically held down, tracked by KeyStateTracker." />
                    <ObjectStatus text="{state>/heldKeys}" state="Information" class="sapUiSmallMarginTop" />
                </VBox>
            </Panel>

            <Panel headerText="Dynamic Enabled" class="sapUiMediumMargin">
                <VBox class="sapUiSmallMargin">
                    <Text text="Toggle the switch to enable/disable a conditional shortcut. The enabled() function is evaluated on every key event." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Feature enabled:" class="sapUiSmallMarginEnd" />
                        <Switch state="{state>/canSave}" />
                    </HBox>
                    <HBox class="sapUiSmallMarginTop">
                        <Label text="{state>/printLabel}" class="sapUiSmallMarginEnd" design="Bold" />
                        <Text text="Print (only fires when toggle is on)" />
                    </HBox>
                </VBox>
            </Panel>
        </content>
    </Page>
</mvc:View>
