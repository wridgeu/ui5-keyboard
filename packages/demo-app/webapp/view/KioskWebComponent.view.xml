<mvc:View
    controllerName="demo.hotkeys.controller.KioskWebComponent"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:kioskWebc="demo.hotkeys.control">
    <Page title="Kiosk Keyboard -- Web Component" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <content>
            <Panel headerText="Status" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{webc>/lastKey}" state="Information" />
                    </HBox>
                    <HBox>
                        <Label text="Layout:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{webc>/layout}" state="Success" />
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="Docked Keyboard (tap any input)" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <MessageStrip
                        text="This page demonstrates the native &lt;kiosk-keyboard&gt; web component consumed inside a UI5 app via a WebComponent.extend() bridge control."
                        type="Information"
                        showIcon="true" />
                    <Label text="Full Name" labelFor="wcNameInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="wcNameInput"
                        placeholder="John Doe"
                        width="100%" />
                    <Label text="Email" labelFor="wcEmailInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="wcEmailInput"
                        placeholder="john@example.com"
                        width="100%" />
                    <Label text="Age" labelFor="wcAgeInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="wcAgeInput"
                        type="Number"
                        placeholder="25"
                        width="100%" />
                </VBox>
            </Panel>

            <kioskWebc:KioskKeyboardWebc
                id="webcKeyboard"
                docked="true"
                autoShow="true"
                autoType="true"
                inputIds="wcNameInput,wcEmailInput,wcAgeInput"
                accessibleName="Web Component Keyboard"
                keyPress=".onKeyPress"
                layoutChange=".onLayoutChange" />
        </content>
    </Page>
</mvc:View>
