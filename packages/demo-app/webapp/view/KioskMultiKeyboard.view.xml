<mvc:View
    controllerName="demo.hotkeys.controller.KioskMultiKeyboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:kiosk="ui5.kiosk">
    <Page titleAlignment="Center" title="Multi-Keyboard Demo" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <content>
            <Text text="Two independent KioskKeyboard instances on one page. Each keyboard targets its own input via inputIds, so they do not cross-claim targets." class="sapUiSmallMarginBottom" />

            <l:Grid defaultSpan="L6 M12 S12">
                <Panel headerText="Product Search (Docked Full Keyboard)">
                    <VBox class="sapUiSmallMargin">
                        <Label text="Search Term" labelFor="searchInput" />
                        <Input
                            id="searchInput"
                            placeholder="Search products..."
                            width="100%" />
                        <HBox class="sapUiSmallMarginTop">
                            <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                            <ObjectStatus text="{state>/multiSearchLastKey}" state="Information" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="Quantity Entry (Inline Numpad)">
                    <VBox class="sapUiSmallMargin">
                        <Label text="Quantity" labelFor="quantityInput" />
                        <Input
                            id="quantityInput"
                            type="Number"
                            placeholder="0"
                            width="12rem" />
                        <kiosk:KioskKeyboard
                            id="quantityKeyboard"
                            keyboardType="Numpad"
                            inputIds="quantityInput"
                            keyPress=".onQuantityKeyPress"
                            ariaLabel="Quantity Numpad"
                            class="sapUiSmallMarginTop" />
                        <HBox class="sapUiSmallMarginTop">
                            <Label text="Last Key:" class="sapUiSmallMarginEnd" />
                            <ObjectStatus text="{state>/multiQuantityLastKey}" state="Information" />
                        </HBox>
                    </VBox>
                </Panel>
            </l:Grid>

            <Panel headerText="Isolation Status" class="sapUiSmallMarginTop">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="Docked Keyboard Open:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/multiDockedOpen}" state="Information" />
                    </HBox>
                    <HBox>
                        <Label text="Quantity Keyboard Target:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="quantityInput (fixed)" state="Success" />
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="Shared Target Ref-Count Visualization" class="sapUiSmallMarginTop">
                <VBox class="sapUiSmallMargin">
                    <Text
                        text="Both hidden keyboards below target the same input. Open A + Open B, then close only A: inputmode must stay 'none'. Close B last: inputmode must restore to 'email'."
                        wrapping="true" />

                    <Label text="Shared Input" labelFor="sharedInput" class="sapUiSmallMarginTop" />
                    <Input
                        id="sharedInput"
                        placeholder="Watch inputmode status update below"
                        width="100%" />

                    <HBox class="sapUiSmallMarginTop" wrap="Wrap">
                        <Button
                            text="Open A"
                            type="Emphasized"
                            enabled="{= !${state>/sharedAOpen} }"
                            press=".onOpenSharedA" />
                        <Button
                            text="Close A"
                            class="sapUiTinyMarginBegin"
                            enabled="{= ${state>/sharedAOpen} }"
                            press=".onCloseSharedA" />
                        <Button
                            text="Open B"
                            class="sapUiTinyMarginBegin"
                            enabled="{= !${state>/sharedBOpen} }"
                            press=".onOpenSharedB" />
                        <Button
                            text="Close B"
                            class="sapUiTinyMarginBegin"
                            enabled="{= ${state>/sharedBOpen} }"
                            press=".onCloseSharedB" />
                        <Button
                            text="Reset Scenario"
                            class="sapUiTinyMarginBegin"
                            press=".onResetSharedScenario" />
                    </HBox>

                    <HBox class="sapUiSmallMarginTop" wrap="Wrap">
                        <Label text="Keyboard A:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus
                            text="{= ${state>/sharedAOpen} ? 'Open' : 'Closed' }"
                            state="{= ${state>/sharedAOpen} ? 'Warning' : 'Success' }" />

                        <Label text="Keyboard B:" class="sapUiSmallMarginBegin sapUiSmallMarginEnd" />
                        <ObjectStatus
                            text="{= ${state>/sharedBOpen} ? 'Open' : 'Closed' }"
                            state="{= ${state>/sharedBOpen} ? 'Warning' : 'Success' }" />
                    </HBox>

                    <HBox class="sapUiTinyMarginTop" wrap="Wrap">
                        <Label text="Current inputmode:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/sharedInputMode}" state="{state>/sharedInputModeState}" />
                    </HBox>

                    <Text text="{state>/sharedExpectation}" wrapping="true" class="sapUiTinyMarginTop" />
                    <Text text="{state>/sharedLastAction}" wrapping="true" class="sapUiTinyMarginTop" />
                </VBox>

                <kiosk:KioskKeyboard
                    id="sharedKeyboardA"
                    docked="true"
                    mobileKeyboard="Custom"
                    targetInput="sharedInput"
                    visible="false" />
                <kiosk:KioskKeyboard
                    id="sharedKeyboardB"
                    docked="true"
                    mobileKeyboard="Custom"
                    targetInput="sharedInput"
                    visible="false" />
            </Panel>

            <kiosk:KioskKeyboard
                id="searchKeyboard"
                docked="true"
                autoShow="true"
                inputIds="searchInput"
                keyPress=".onSearchKeyPress"
                afterOpen=".onSearchAfterOpen"
                afterClose=".onSearchAfterClose"
                ariaLabel="Product Search Keyboard" />
        </content>
    </Page>
</mvc:View>
