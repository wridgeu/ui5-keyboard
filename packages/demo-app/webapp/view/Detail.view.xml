<mvc:View
    controllerName="demo.hotkeys.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page titleAlignment="Center" title="Scope + Recorder - Detail View" showNavButton="true" navButtonPress=".onNavBack" class="sapUiContentPadding">
        <landmarkInfo>
            <PageAccessibleLandmarkInfo rootRole="None" headerRole="Banner" />
        </landmarkInfo>
        <content>
            <Panel headerText="What to Test on This Page" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <MessageStrip
                        type="Information"
                        showIcon="true"
                        text="Purpose: verify route-scoped shortcuts and HotkeyRecorder behavior in one place." />
                    <Text
                        text="1) Scope check: Active Scope should show the detail route while this page is open." class="sapUiSmallMarginTop" />
                    <Text text="2) Shortcut check: F5 should trigger the detail-specific action; Ctrl/Cmd+S should still work globally." />
                    <Text
                        text="3) Recorder check: Record captures one hotkey event; Escape cancels; Backspace/Delete clears the value." />
                </VBox>
            </Panel>

            <Panel headerText="Status" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <HBox>
                        <Label text="Active Scope:" class="sapUiSmallMarginEnd" />
                        <Text text="{state>/activeScope}" />
                    </HBox>
                    <HBox>
                        <Label text="Last Action:" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{state>/lastAction}" state="Information" />
                    </HBox>
                </VBox>
            </Panel>

            <Panel headerText="Detail View Shortcuts" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="F5 here triggers 'Refresh (Detail View)' - different from Main View." />
                    <Text text="Ctrl+S / Cmd+S still works (global scope)." />
                    <Text text="Press the back button or Mod+B to return to the Hotkeys Hub." />
                </VBox>
            </Panel>

            <Panel headerText="Record a Shortcut (HotkeyRecorder)" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Text text="Click Record, then press one hotkey (one action key with optional modifiers)." />
                    <Text text="After recording, the shortcut is active. Press it to trigger a MessageToast." class="sapUiTinyMarginTop" />
                    <Text text="Use Reset to clear the shortcut and record a new one." />
                    <Text text="Examples that work: G, F5, Ctrl+Shift+K, Alt+ArrowDown." class="sapUiTinyMarginTop" />
                    <Text text="Not supported as one hotkey: G+K (two action keys) or sequences like G then K." />
                    <Text text="Tip: prefer modifier-based shortcuts for app actions; single letters are often suppressed in inputs with default settings." />
                    <HBox alignItems="Center" class="sapUiSmallMarginTop">
                        <Label text="Recorded:" class="sapUiSmallMarginEnd" />
                        <Input value="{state>/recordedShortcut}" editable="false" width="200px" />
                        <Button
                            text="{= ${state>/isRecording} ? 'Recording...' : 'Record'}"
                            press=".onStartRecording"
                            type="{= ${state>/isRecording} ? 'Reject' : 'Accept'}"
                            class="sapUiSmallMarginBegin" />
                        <Button
                            text="Reset"
                            press=".onResetRecording"
                            type="Default"
                            enabled="{= !!${state>/recordedShortcut} &amp;&amp; !${state>/isRecording}}"
                            class="sapUiSmallMarginBegin" />
                    </HBox>
                </VBox>
            </Panel>
        </content>
    </Page>
</mvc:View>
