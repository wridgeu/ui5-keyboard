{
  "_version": "2.0.0",
  "sap.app": {
    "id": "demo.hotkeys",
    "type": "application",
    "title": "ui5.hotkeys Demo",
    "applicationVersion": {
      "version": "0.1.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "dependencies": {
      "minUI5Version": "1.144.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "ui5.hotkeys": {},
        "ui5.kiosk": {}
      }
    },
    "rootView": {
      "viewName": "demo.hotkeys.view.App",
      "type": "XML",
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "demo.hotkeys.view",
        "controlId": "appControl",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "main",
          "pattern": "",
          "target": "main"
        },
        {
          "name": "detail",
          "pattern": "detail",
          "target": "detail"
        },
        {
          "name": "kiosk",
          "pattern": "kiosk",
          "target": "kiosk"
        }
      ],
      "targets": {
        "main": {
          "id": "main",
          "name": "Main"
        },
        "detail": {
          "id": "detail",
          "name": "Detail"
        },
        "kiosk": {
          "id": "kiosk",
          "name": "Kiosk"
        }
      }
    },
    "models": {
      "state": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
          "data": {
            "lastAction": "None",
            "activeScope": "__global__",
            "platform": "",
            "saveLabel": "",
            "escapeLabel": "",
            "f5Label": "",
            "navLabel": "",
            "kioskLastKey": "None",
            "kioskLayout": "qwerty"
          }
        }
      }
    }
  }
}
