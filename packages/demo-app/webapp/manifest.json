{
  "_version": "2.0.0",
  "sap.app": {
    "id": "demo.hotkeys",
    "type": "application",
    "title": "UI5 Keyboard Libraries Demo",
    "applicationVersion": {
      "version": "0.1.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "dependencies": {
      "minUI5Version": "1.144.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "ui5.hotkeys": {},
        "ui5.kiosk": {}
      }
    },
    "rootView": {
      "viewName": "demo.hotkeys.view.App",
      "type": "XML",
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "demo.hotkeys.view",
        "controlId": "appControl",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "main",
          "pattern": "",
          "target": "main"
        },
        {
          "name": "detail",
          "pattern": "detail",
          "target": "detail"
        },
        {
          "name": "kioskHub",
          "pattern": "kiosk",
          "target": "kioskHub"
        },
        {
          "name": "kioskDocked",
          "pattern": "kiosk/docked",
          "target": "kioskDocked"
        },
        {
          "name": "kioskPopover",
          "pattern": "kiosk/popover",
          "target": "kioskPopover"
        },
        {
          "name": "kioskInputIds",
          "pattern": "kiosk/input-ids",
          "target": "kioskInputIds"
        },
        {
          "name": "kioskProgrammatic",
          "pattern": "kiosk/programmatic",
          "target": "kioskProgrammatic"
        },
        {
          "name": "kioskComponent",
          "pattern": "kiosk/component",
          "target": "kioskComponent"
        }
      ],
      "targets": {
        "main": {
          "id": "main",
          "name": "Main"
        },
        "detail": {
          "id": "detail",
          "name": "Detail"
        },
        "kioskHub": {
          "id": "kioskHub",
          "name": "KioskHub"
        },
        "kioskDocked": {
          "id": "kioskDocked",
          "name": "KioskDocked"
        },
        "kioskPopover": {
          "id": "kioskPopover",
          "name": "KioskPopover"
        },
        "kioskInputIds": {
          "id": "kioskInputIds",
          "name": "KioskInputIds"
        },
        "kioskProgrammatic": {
          "id": "kioskProgrammatic",
          "name": "KioskProgrammatic"
        },
        "kioskComponent": {
          "id": "kioskComponent",
          "name": "KioskComponent"
        }
      }
    },
    "models": {
      "state": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
          "data": {
            "lastAction": "None",
            "activeScope": "__global__",
            "platform": "",
            "saveLabel": "",
            "escapeLabel": "",
            "f5Label": "",
            "navLabel": "",
            "sequenceStatus": "",
            "heldKeys": "None",
            "canSave": true,
            "printLabel": "",
            "recordedShortcut": "",
            "isRecording": false,
            "kioskLastKey": "None",
            "kioskLayout": "qwerty",
            "kioskEnabled": true,
            "kioskMobileKeyboard": "Custom",
            "kioskIsOpen": false,
            "kioskKeyboardType": "Full",
            "kioskCurrentTarget": "None"
          }
        }
      }
    }
  }
}
