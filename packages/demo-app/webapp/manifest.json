{
  "_version": "2.0.0",
  "sap.app": {
    "id": "demo.hotkeys",
    "type": "application",
    "title": "UI5 Keyboard Libraries Demo",
    "applicationVersion": {
      "version": "0.1.0"
    },
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [""],
      "fallbackLocale": ""
    },
    "crossNavigation": {
      "inbounds": {
        "DemoApp-display": {
          "semanticObject": "DemoApp",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "dependencies": {
      "minUI5Version": "1.145.0",
      "libs": {
