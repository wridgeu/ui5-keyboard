{
  "name": "kiosk-keyboard-webc",
  "version": "0.1.0",
  "description": "Native web component variant of the kiosk keyboard, built on UI5 Web Components framework",
  "keywords": [
    "custom-element",
    "kiosk",
    "on-screen-keyboard",
    "touchscreen",
    "virtual-keyboard",
    "web-component"
  ],
  "homepage": "https://github.com/wridgeu/ui5-keyboard/tree/main/packages/kiosk-keyboard-webc",
  "bugs": "https://github.com/wridgeu/ui5-keyboard/issues",
  "license": "MIT",
  "author": "Marco Beier",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/ui5-keyboard.git",
    "directory": "packages/kiosk-keyboard-webc"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/KioskKeyboard.js",
    "./dist/kiosk-keyboard.bundle.js",
    "./dist/bundle.esm.js",
    "./dist/Assets.js",
    "./dist/generated/**"
  ],
  "main": "dist/KioskKeyboard.js",
  "types": "dist/KioskKeyboard.d.ts",
  "exports": {
    ".": {
      "types": "./dist/KioskKeyboard.d.ts",
      "default": "./dist/KioskKeyboard.js"
    },
    "./bundle": {
      "types": "./dist/bundle.esm.d.ts",
      "default": "./dist/bundle.esm.js"
    },
    "./Assets": {
      "types": "./dist/Assets.d.ts",
      "default": "./dist/Assets.js"
    },
    "./layouts/*": {
      "types": "./dist/layouts/*.d.ts",
      "default": "./dist/layouts/*.js"
    },
    "./middleware/*": {
      "types": "./dist/middleware/*.d.ts",
      "default": "./dist/middleware/*.js"
    },
    "./variants": {
      "types": "./dist/core/latin-variants.d.ts",
      "default": "./dist/core/latin-variants.js"
    },
    "./customElements": "./dist/custom-elements.json",
    "./dist/*": "./dist/*",
    "./*": "./dist/*"
  },
  "scripts": {
    "clean": "rimraf dist src/generated tsconfig.tsbuildinfo",
    "generate": "ui5nps generate",
    "build:dev": "npm run generate && tsc --build --force",
    "prebuild": "npm run clean",
    "build": "npm run build:dev && npm run build:bundle && npm run generateAPI",
    "build:bundle": "vite build",
    "build:demo-page": "npm run generate && vite build --config vite.demo.config.ts",
    "prestart": "npm run generate",
    "start": "vite --port 8084 --open /test/pages/index.html",
    "prestart:key-style-demo": "npm run generate",
    "start:key-style-demo": "vite --port 8084 --open /test/pages/key-style-demo.html",
    "prepublishOnly": "node ../../tools/copy-license.mjs && npm run build",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit --composite false",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "npm run generate && web-test-runner",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:component",
    "test:coverage:unit": "vitest run --coverage",
    "test:coverage:component": "npm run generate && web-test-runner --coverage",
    "test:e2e": "npm run generate && playwright test --project=desktop",
    "test:e2e:ci": "npm run generate && playwright test --project=desktop --ignore-snapshots",
    "test:e2e:open": "npm run generate && playwright test --project=desktop --ui",
    "test:e2e:update": "npm run generate && playwright test --project=desktop --update-snapshots",
    "test:e2e:phone": "npm run test:e2e:phone-md",
    "test:e2e:phone-sm": "npm run generate && playwright test --project=phone-sm",
    "test:e2e:phone-md": "npm run generate && playwright test --project=phone-md",
    "test:e2e:phone-lg": "npm run generate && playwright test --project=phone-lg",
    "test:e2e:tablet": "npm run generate && playwright test --project=tablet",
    "test:e2e:phone:update": "npm run test:e2e:phone-md:update",
    "test:e2e:phone-sm:update": "npm run generate && playwright test --project=phone-sm --update-snapshots",
    "test:e2e:phone-md:update": "npm run generate && playwright test --project=phone-md --update-snapshots",
    "test:e2e:phone-lg:update": "npm run generate && playwright test --project=phone-lg --update-snapshots",
    "test:e2e:tablet:update": "npm run generate && playwright test --project=tablet --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:e2e:all-devices": "npm run generate && playwright test",
    "test:e2e:all-devices:sequential": "npm run generate && playwright test --workers=1",
    "test:e2e:update:all-devices": "npm run generate && playwright test --update-snapshots",
    "typecheck:e2e": "tsc -p test/e2e/tsconfig.json --noEmit",
    "generateAPI": "ui5nps generateAPI"
  },
  "dependencies": {
    "@ui5/webcomponents": "~2.22.0",
    "@ui5/webcomponents-base": "~2.22.0",
    "@ui5/webcomponents-icons": "~2.22.0",
    "@ui5/webcomponents-theming": "~2.22.0"
  },
  "devDependencies": {
    "@open-wc/testing": "~4.0.0",
    "@playwright/test": "~1.59.1",
    "@ui5/webcomponents-tools": "2.22.0",
    "@vitest/coverage-v8": "~4.1.7",
    "@web/dev-server-esbuild": "~1.0.5",
    "@web/test-runner": "~0.20.2",
    "@web/test-runner-playwright": "~0.11.1",
    "jsdom": "~29.1.1",
    "rimraf": "~6.1.3",
    "vite": "~8.0.14",
    "vitest": "~4.1.7"
  },
  "engines": {
    "node": ">=20.19"
  },
  "customElements": "dist/custom-elements.json",
  "ui5": {
    "webComponentsPackage": true
  }
}
