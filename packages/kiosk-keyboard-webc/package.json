{
  "name": "kiosk-keyboard-webc",
  "version": "0.1.0",
  "private": true,
  "description": "Native web component variant of the kiosk keyboard, built on UI5 Web Components framework",
  "keywords": [
    "custom-element",
    "kiosk",
    "on-screen-keyboard",
    "touchscreen",
    "virtual-keyboard",
    "web-component"
  ],
  "homepage": "https://github.com/wridgeu/ui5-lib-keyboard/tree/main/packages/kiosk-keyboard-webc",
  "bugs": "https://github.com/wridgeu/ui5-lib-keyboard/issues",
  "license": "MIT",
  "author": "Marco Beier",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/ui5-lib-keyboard.git",
    "directory": "packages/kiosk-keyboard-webc"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/KioskKeyboard.js",
  "types": "dist/KioskKeyboard.d.ts",
  "exports": {
    ".": {
      "types": "./dist/KioskKeyboard.d.ts",
      "default": "./dist/KioskKeyboard.js"
    },
    "./bundle": {
      "types": "./dist/bundle.esm.d.ts",
      "default": "./dist/bundle.esm.js"
    },
    "./Assets": {
      "types": "./dist/Assets.d.ts",
      "default": "./dist/Assets.js"
    },
    "./layouts/fkey-row": {
      "types": "./dist/layouts/fkey-row.d.ts",
      "default": "./dist/layouts/fkey-row.js"
    },
    "./layouts/nav-row": {
      "types": "./dist/layouts/nav-row.d.ts",
      "default": "./dist/layouts/nav-row.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "clean": "rimraf dist src/generated",
    "generate": "ui5nps generate",
    "build:dev": "npm run generate && tsc",
    "build": "npm run build:dev && npm run build:bundle && npm run generateAPI",
    "build:bundle": "vite build",
    "prestart": "npm run generate",
    "start": "vite --port 8084 --open /test/pages/index.html",
    "prestart:key-style-demo": "npm run generate",
    "start:key-style-demo": "vite --port 8084 --open /test/pages/key-style-demo.html",
    "prepublishOnly": "node -e \"import('node:fs').then(f=>f.copyFileSync('../../LICENSE','./LICENSE'))\" && npm run build",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "npm run generate && web-test-runner",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:component",
    "test:coverage:unit": "vitest run --coverage",
    "test:coverage:component": "npm run generate && web-test-runner --coverage",
    "test:e2e": "npm run generate && wdio run test/e2e/wdio.conf.ts",
    "test:e2e:open": "npm run generate && wdio run test/e2e/wdio.conf.ts -- --headed",
    "test:e2e:update": "npm run generate && wdio run test/e2e/wdio.conf.ts -- --update-visual-baseline",
    "test:e2e:phone": "npm run generate && wdio run test/e2e/wdio-device.conf.ts -- --device=phone",
    "test:e2e:tablet": "npm run generate && wdio run test/e2e/wdio-device.conf.ts -- --device=tablet",
    "test:e2e:phone:update": "npm run generate && wdio run test/e2e/wdio-device.conf.ts -- --device=phone --update-visual-baseline",
    "test:e2e:tablet:update": "npm run generate && wdio run test/e2e/wdio-device.conf.ts -- --device=tablet --update-visual-baseline",
    "test:e2e:report": "node ../../tools/visual-report.mjs test/e2e/__screenshots__",
    "test:e2e:all-devices": "npm run generate && concurrently --kill-others-on-fail -n desktop,phone,tablet \"wdio run test/e2e/wdio.conf.ts\" \"wdio run test/e2e/wdio-device.conf.ts -- --device=phone\" \"wdio run test/e2e/wdio-device.conf.ts -- --device=tablet\"",
    "test:e2e:all-devices:sequential": "npm run test:e2e && npm run test:e2e:phone && npm run test:e2e:tablet",
    "typecheck:e2e": "tsc -p test/e2e/tsconfig.json --noEmit",
    "generateAPI": "ui5nps generateAPI"
  },
  "dependencies": {
    "@ui5/webcomponents": "^2.19.2",
    "@ui5/webcomponents-base": "^2.19.2",
    "@ui5/webcomponents-icons": "^2.19.2",
    "@ui5/webcomponents-theming": "^2.19.2"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@ui5/webcomponents-tools": "^2.19.2",
    "@vitest/coverage-v8": "^4.1.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/visual-service": "^6.0.0",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "concurrently": "^9.2.1",
    "jsdom": "^26.0.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "webdriverio": "^9.0.0"
  },
  "customElements": "dist/custom-elements.json",
  "ui5": {
    "webComponentsPackage": true
  }
}
