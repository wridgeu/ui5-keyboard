{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "rootDir": "..",
    "noUncheckedIndexedAccess": false,
    "types": ["node", "mocha"]
  },
  "include": ["../src/**/*.ts", "../src/**/*.tsx", "**/*.ts", "**/*.tsx"],
  "exclude": ["e2e/**/*.ts"]
}
