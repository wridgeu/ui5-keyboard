{
  "name": "ui5-lib-hotkeys",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative keyboard shortcut management for SAPUI5/OpenUI5 applications",
  "keywords": [
    "hotkeys",
    "keybindings",
    "keyboard-shortcuts",
    "openui5",
    "sapui5",
    "ui5"
  ],
  "homepage": "https://github.com/wridgeu/ui5-lib-keyboard/tree/main/packages/hotkeys",
  "bugs": "https://github.com/wridgeu/ui5-lib-keyboard/issues",
  "license": "MIT",
  "author": "Marco Beier",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/ui5-lib-keyboard.git",
    "directory": "packages/hotkeys"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "ui5.yaml",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/resources/ui5/hotkeys/library.js",
  "types": "dist/resources/ui5/hotkeys/HotkeyManager.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "ui5 build --clean-dest",
    "prepublishOnly": "node -e \"import('node:fs').then(f=>f.copyFileSync('../../LICENSE','./LICENSE'))\" && npm run build",
    "start": "ui5 serve --port 8081 -o test-resources/sap/ui/qunit/testrunner.html?testpage=%2Ftest-resources%2Fui5%2Fhotkeys%2Fqunit%2Ftestsuite.qunit.html&autostart=true",
    "test": "wdio run test/qunit/wdio.conf.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ui5/cli": "^4.0.0",
    "ui5-tooling-transpile": "^3.9.0"
  }
}
