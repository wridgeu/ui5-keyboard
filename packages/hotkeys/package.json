{
  "name": "ui5-lib-hotkeys",
  "version": "0.1.0",
  "description": "Declarative keyboard shortcut management for SAPUI5/OpenUI5 applications",
  "keywords": [
    "hotkeys",
    "keybindings",
    "keyboard-shortcuts",
    "openui5",
    "sapui5",
    "ui5"
  ],
  "homepage": "https://github.com/wridgeu/ui5-keyboard/tree/main/packages/hotkeys",
  "bugs": "https://github.com/wridgeu/ui5-keyboard/issues",
  "license": "MIT",
  "author": "Marco Beier",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/ui5-keyboard.git",
    "directory": "packages/hotkeys"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "ui5.yaml",
    "README.md"
  ],
  "type": "module",
  "main": "dist/resources/ui5/hotkeys/library.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "ui5 build --clean-dest --create-build-manifest",
    "prepublishOnly": "npm run build",
    "start": "npm run start:qunit",
    "start:qunit": "ui5 serve --port 8081 -o \"test-resources/sap/ui/qunit/testrunner.html?testpage=%2Ftest-resources%2Fui5%2Fhotkeys%2Fqunit%2Ftestsuite.qunit.html&autostart=true\"",
    "test:qunit": "node ../../tools/check-port-free.mjs 8081 && start-server-and-test \"ui5 serve --port 8081\" http://localhost:8081/test-resources/ui5/hotkeys/qunit/testsuite.qunit.html \"ui5-test-runner --url http://localhost:8081/test-resources/ui5/hotkeys/qunit/testsuite.qunit.html --report-dir report --no-screenshot --browser $/puppeteer.js\"",
    "test": "npm run test:qunit",
    "typecheck": "tsc --noEmit",
    "lint:ui5": "ui5lint --ui5-config ui5.yaml"
  },
  "devDependencies": {
    "@openui5/types": "1.136.18",
    "@ui5/cli": "~4.0.63",
    "@ui5/linter": "~1.23.5",
    "rimraf": "~6.1.3",
    "start-server-and-test": "~3.0.12",
    "ui5-test-runner": "~5.14.0",
    "ui5-tooling-transpile": "~3.13.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
