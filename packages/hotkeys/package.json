{
  "name": "ui5-lib-hotkeys",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative keyboard shortcut management for SAPUI5/OpenUI5 applications",
  "keywords": [
    "hotkeys",
    "keybindings",
    "keyboard-shortcuts",
    "openui5",
    "sapui5",
    "ui5"
  ],
  "homepage": "https://github.com/wridgeu/ui5-lib-keyboard/tree/main/packages/hotkeys",
  "bugs": "https://github.com/wridgeu/ui5-lib-keyboard/issues",
  "license": "MIT",
  "author": "Marco Beier",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/ui5-lib-keyboard.git",
    "directory": "packages/hotkeys"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "ui5.yaml",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/resources/ui5/hotkeys/library.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "ui5 build --clean-dest --create-build-manifest",
    "prepublishOnly": "node -e \"import('node:fs').then(f=>f.copyFileSync('../../LICENSE','./LICENSE'))\" && npm run build",
    "start": "npm run start:qunit",
    "start:qunit": "ui5 serve --port 8081 -o \"test-resources/sap/ui/qunit/testrunner.html?testpage=%2Ftest-resources%2Fui5%2Fhotkeys%2Fqunit%2Ftestsuite.qunit.html&autostart=true\"",
    "test:qunit": "wdio run test/qunit/wdio.conf.ts",
    "test": "npm run test:qunit",
    "typecheck": "tsc --noEmit",
    "lint:ui5": "ui5lint --ui5-config ui5.yaml"
  },
  "devDependencies": {
    "@openui5/types": "1.144.0",
    "@ui5/cli": "^4.0.44",
    "@ui5/linter": "^1.20.11",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "ui5-tooling-transpile": "^3.9.0",
    "wdio-qunit-service": "^2.0.0"
  }
}
