{
  "_version": "2.0.0",
  "sap.app": {
    "id": "ui5.kiosk",
    "type": "library",
    "embeds": [],
    "applicationVersion": {
      "version": "0.1.0"
    },
    "title": "UI5 Kiosk Keyboard",
    "description": "On-screen virtual keyboard control for SAPUI5/OpenUI5 applications",
    "offline": true
  },
  "sap.ui": {
    "technology": "UI5",
    "supportedThemes": ["sap_horizon", "sap_horizon_dark", "sap_horizon_hcb", "sap_horizon_hcw"],
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.ui.core": {
          "minVersion": "1.136.0"
        },
        "sap.m": {
          "minVersion": "1.136.0"
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "library": {
      "i18n": {
        "bundleUrl": "i18n/messagebundle.properties",
        "fallbackLocale": "",
        "supportedLocales": ["", "ar", "de", "ja"]
      },
      "css": true,
      "content": {
        "controls": ["ui5.kiosk.KioskKeyboard"],
        "elements": [],
        "types": [
          "ui5.kiosk.KeyboardLayout",
          "ui5.kiosk.KeyboardType",
          "ui5.kiosk.MobileKeyboard",
          "ui5.kiosk.FKeyMode"
        ],
        "interfaces": []
      }
    }
  }
}
