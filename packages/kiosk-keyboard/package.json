{
  "name": "ui5-lib-kiosk-keyboard",
  "version": "0.1.0",
  "description": "On-screen virtual keyboard control for SAPUI5/OpenUI5 kiosk and touch applications",
  "keywords": [
    "kiosk",
    "on-screen-keyboard",
    "openui5",
    "sapui5",
    "touchscreen",
    "ui5",
    "virtual-keyboard"
  ],
  "homepage": "https://github.com/wridgeu/ui5-lib-keyboard/tree/main/packages/kiosk-keyboard",
  "bugs": "https://github.com/wridgeu/ui5-lib-keyboard/issues",
  "license": "MIT",
  "author": "Marco Beier",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/ui5-lib-keyboard.git",
    "directory": "packages/kiosk-keyboard"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "ui5.yaml",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/resources/ui5/kiosk/library.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "generate": "ts-interface-generator",
    "prebuild": "npm run generate",
    "build": "ui5 build --clean-dest --create-build-manifest",
    "prepublishOnly": "node -e \"import('node:fs').then(f=>f.copyFileSync('../../LICENSE','./LICENSE'))\" && npm run build",
    "start": "npm run start:qunit",
    "start:qunit": "ui5 serve --port 8082 -o \"test-resources/sap/ui/qunit/testrunner.html?testpage=%2Ftest-resources%2Fui5%2Fkiosk%2Fqunit%2Ftestsuite.qunit.html&autostart=true\"",
    "start:visual": "ui5 serve --port 8082 -o test-resources/ui5/kiosk/e2e/visual/index.html",
    "test": "npm run test:qunit && npm run test:e2e",
    "test:qunit": "wdio run test/qunit/wdio.conf.ts",
    "test:e2e": "wdio run test/e2e/wdio.conf.ts",
    "test:e2e:open": "wdio run test/e2e/wdio.conf.ts -- --headed",
    "test:e2e:update": "wdio run test/e2e/wdio.conf.ts -- --update-visual-baseline",
    "test:e2e:flp": "wdio run test/e2e/wdio-flp.conf.ts",
    "test:e2e:phone": "npm run test:e2e:phone-md",
    "test:e2e:phone-sm": "wdio run test/e2e/wdio-device.conf.ts --maxInstances 1 -- --device=phone-sm",
    "test:e2e:phone-md": "wdio run test/e2e/wdio-device.conf.ts --maxInstances 1 -- --device=phone-md",
    "test:e2e:phone-lg": "wdio run test/e2e/wdio-device.conf.ts --maxInstances 1 -- --device=phone-lg",
    "test:e2e:tablet": "wdio run test/e2e/wdio-device.conf.ts --maxInstances 1 -- --device=tablet",
    "test:e2e:phone:update": "npm run test:e2e:phone-md:update",
    "test:e2e:phone-sm:update": "wdio run test/e2e/wdio-device.conf.ts --maxInstances 1 -- --device=phone-sm --update-visual-baseline",
    "test:e2e:phone-md:update": "wdio run test/e2e/wdio-device.conf.ts --maxInstances 1 -- --device=phone-md --update-visual-baseline",
    "test:e2e:phone-lg:update": "wdio run test/e2e/wdio-device.conf.ts --maxInstances 1 -- --device=phone-lg --update-visual-baseline",
    "test:e2e:tablet:update": "wdio run test/e2e/wdio-device.conf.ts --maxInstances 1 -- --device=tablet --update-visual-baseline",
    "test:e2e:report": "node ../../tools/visual-report.mjs test/e2e/__screenshots__",
    "test:e2e:browse": "node ../../tools/visual-browse.mjs test/e2e/__baselines__ --include-screenshots",
    "test:e2e:all-devices": "concurrently --kill-others-on-fail -n desktop,phone-sm,phone-md,phone-lg,tablet \"wdio run test/e2e/wdio.conf.ts\" \"wdio run test/e2e/wdio-device.conf.ts -- --device=phone-sm\" \"wdio run test/e2e/wdio-device.conf.ts -- --device=phone-md\" \"wdio run test/e2e/wdio-device.conf.ts -- --device=phone-lg\" \"wdio run test/e2e/wdio-device.conf.ts -- --device=tablet\"",
    "test:e2e:all-devices:sequential": "npm run test:e2e && npm run test:e2e:phone-sm && npm run test:e2e:phone-md && npm run test:e2e:phone-lg && npm run test:e2e:tablet",
    "test:e2e:update:all-devices": "npm run test:e2e:update && npm run test:e2e:phone-sm:update && npm run test:e2e:phone-md:update && npm run test:e2e:phone-lg:update && npm run test:e2e:tablet:update",
    "test:e2e:docs": "wdio run test/e2e/wdio.conf.ts --spec test/e2e/readme-screenshots.test.ts -- --readme-screenshots",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p test/e2e/tsconfig.json --noEmit",
    "lint:ui5": "ui5lint --ui5-config ui5.yaml"
  },
  "devDependencies": {
    "@openui5/types": "1.144.0",
    "@ui5/cli": "~4.0.51",
    "@ui5/linter": "~1.20.18",
    "@ui5/ts-interface-generator": "~0.10.5",
    "@wdio/cli": "~9.27.0",
    "@wdio/globals": "~9.27.0",
    "@wdio/local-runner": "~9.27.0",
    "@wdio/mocha-framework": "~9.27.0",
    "@wdio/spec-reporter": "~9.27.0",
    "@wdio/visual-service": "~9.2.0",
    "ui5-tooling-transpile": "~3.11.0",
    "wdio-qunit-service": "~2.0.0",
    "wdio-ui5-service": "~3.0.0",
    "webdriverio": "~9.27.0"
  }
}
