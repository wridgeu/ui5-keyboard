{
  "name": "ui5-lib-kiosk-keyboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && ui5 build --clean-dest && node -e \"import{cp}from'node:fs/promises';cp('../../LICENSE','dist/LICENSE');\"",
    "start": "ui5 serve --port 8082 -o test-resources/ui5/kiosk/qunit/testsuite.qunit.html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/qunit": "^2.19.13",
    "@ui5/cli": "^4.0.0",
    "rimraf": "^6.0.0",
    "ui5-tooling-transpile": "^3.9.0"
  }
}
