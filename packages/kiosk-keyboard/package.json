{
  "name": "ui5-lib-kiosk-keyboard",
  "version": "0.1.0",
  "description": "On-screen virtual keyboard control for SAPUI5/OpenUI5 kiosk and touch applications",
  "keywords": [
    "kiosk",
    "on-screen-keyboard",
    "openui5",
    "sapui5",
    "touchscreen",
    "ui5",
    "virtual-keyboard"
  ],
  "homepage": "https://github.com/wridgeu/ui5-keyboard/tree/main/packages/kiosk-keyboard",
  "bugs": "https://github.com/wridgeu/ui5-keyboard/issues",
  "license": "MIT",
  "author": "Marco Beier",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/ui5-keyboard.git",
    "directory": "packages/kiosk-keyboard"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "ui5.yaml",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/resources/ui5/kiosk/library.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "generate": "ts-interface-generator",
    "prebuild": "npm run generate",
    "build": "ui5 build --clean-dest --create-build-manifest",
    "prepublishOnly": "node ../../tools/copy-license.mjs && npm run build",
    "start": "npm run start:qunit",
    "start:qunit": "ui5 serve --port 8082 -o \"test-resources/sap/ui/qunit/testrunner.html?testpage=%2Ftest-resources%2Fui5%2Fkiosk%2Fqunit%2Ftestsuite.qunit.html&autostart=true\"",
    "start:visual": "ui5 serve --port 8082 -o test-resources/ui5/kiosk/e2e/visual/index.html",
    "test": "npm run test:qunit && npm run test:e2e",
    "test:qunit": "start-server-and-test \"ui5 serve --port 8082\" http://localhost:8082/test-resources/ui5/kiosk/qunit/testsuite.qunit.html \"ui5-test-runner --url http://localhost:8082/test-resources/ui5/kiosk/qunit/testsuite.qunit.html --report-dir report --browser $/playwright.js\"",
    "test:e2e": "playwright test --project=desktop",
    "test:e2e:ci": "playwright test --project=desktop --ignore-snapshots",
    "test:e2e:open": "playwright test --project=desktop --ui",
    "test:e2e:update": "playwright test --project=desktop --update-snapshots",
    "test:e2e:flp": "playwright test --config playwright.flp.config.ts",
    "test:e2e:phone": "npm run test:e2e:phone-md",
    "test:e2e:phone-sm": "playwright test --project=phone-sm",
    "test:e2e:phone-md": "playwright test --project=phone-md",
    "test:e2e:phone-lg": "playwright test --project=phone-lg",
    "test:e2e:tablet": "playwright test --project=tablet",
    "test:e2e:phone:update": "npm run test:e2e:phone-md:update",
    "test:e2e:phone-sm:update": "playwright test --project=phone-sm --update-snapshots",
    "test:e2e:phone-md:update": "playwright test --project=phone-md --update-snapshots",
    "test:e2e:phone-lg:update": "playwright test --project=phone-lg --update-snapshots",
    "test:e2e:tablet:update": "playwright test --project=tablet --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:e2e:all-devices": "playwright test",
    "test:e2e:all-devices:sequential": "playwright test --workers=1",
    "test:e2e:update:all-devices": "playwright test --update-snapshots",
    "test:e2e:docs": "playwright test --config playwright.docs.config.ts",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p test/e2e/tsconfig.json --noEmit",
    "lint:ui5": "ui5lint --ui5-config ui5.yaml"
  },
  "devDependencies": {
    "@openui5/types": "1.148.0",
    "@ui5/cli": "~4.0.55",
    "@ui5/linter": "~1.21.1",
    "@ui5/ts-interface-generator": "~0.11.1",
    "ui5-tooling-transpile": "~3.11.1"
  },
  "engines": {
    "node": ">=22"
  }
}
