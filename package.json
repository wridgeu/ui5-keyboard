{
  "name": "ui5-keyboard",
  "private": true,
  "description": "UI5 TypeScript libraries for keyboard interaction in SAPUI5/OpenUI5 applications",
  "homepage": "https://github.com/wridgeu/ui5-lib-keyboard",
  "bugs": "https://github.com/wridgeu/ui5-lib-keyboard/issues",
  "license": "MIT",
  "author": "Marco Beier",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/ui5-lib-keyboard.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "generate": "ts-interface-generator",
    "build": "npm run generate && npm run build:hotkeys && npm run build:kiosk",
    "build:hotkeys": "npm run build -w packages/hotkeys",
    "build:kiosk": "npm run build -w packages/kiosk-keyboard",
    "start": "npm run start -w packages/demo-app",
    "start:hotkeys": "npm run start -w packages/hotkeys",
    "start:kiosk": "npm run start -w packages/kiosk-keyboard",
    "lint": "oxlint packages/",
    "lint:fix": "oxlint --fix packages/",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "npm run generate && tsc -b && npm run typecheck -w packages/demo-app",
    "check": "npm run fmt:check && npm run lint && npm run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@openui5/types": "1.144.0",
    "@ui5/ts-interface-generator": "^0.10.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.ts": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,yaml,yml,md,html,xml,css}": "oxfmt"
  },
  "engines": {
    "node": ">=22"
  }
}
