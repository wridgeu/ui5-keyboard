{
  "name": "ui5-lib-keyboard",
  "private": true,
  "description": "UI5 TypeScript libraries for keyboard interaction in SAPUI5/OpenUI5 applications",
  "homepage": "https://github.com/wridgeu/ui5-lib-keyboard",
  "bugs": "https://github.com/wridgeu/ui5-lib-keyboard/issues",
  "license": "MIT",
  "author": "Marco Beier",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/ui5-lib-keyboard.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build:hotkeys && npm run build:kiosk && npm run build:kiosk-webc",
    "build:hotkeys": "npm run build -w packages/hotkeys",
    "build:kiosk": "npm run build -w packages/kiosk-keyboard",
    "build:kiosk-webc": "npm run build -w packages/kiosk-keyboard-webc",
    "build:demo": "npm run build -w packages/demo-app",
    "build:all": "npm run build && npm run build:demo",
    "generate:kiosk": "npm run generate -w packages/kiosk-keyboard",
    "generate:kiosk-webc": "npm run generate -w packages/kiosk-keyboard-webc",
    "clean": "npm run clean:hotkeys && npm run clean:kiosk && npm run clean:kiosk-webc && npm run clean:demo",
    "clean:hotkeys": "npm run clean -w packages/hotkeys",
    "clean:kiosk": "npm run clean -w packages/kiosk-keyboard",
    "clean:kiosk-webc": "npm run clean -w packages/kiosk-keyboard-webc",
    "clean:demo": "npm run clean -w packages/demo-app",
    "start": "npm run build:kiosk-webc && npm run start:demo",
    "start:demo": "npm run start -w packages/demo-app",
    "start:flp": "npm run start:flp -w packages/demo-app",
    "start:hotkeys": "npm run start:qunit -w packages/hotkeys",
    "start:kiosk": "npm run start:qunit -w packages/kiosk-keyboard",
    "start:kiosk:visual": "npm run start:visual -w packages/kiosk-keyboard",
    "start:kiosk-webc": "npm run start -w packages/kiosk-keyboard-webc",
    "start:kiosk-webc:key-style-demo": "npm run start:key-style-demo -w packages/kiosk-keyboard-webc",
    "test": "npm run test:hotkeys && npm run test:kiosk && npm run test:kiosk-webc && npm run test:kiosk-webc:component",
    "test:qunit": "npm run test:hotkeys:qunit && npm run test:kiosk:qunit",
    "test:hotkeys": "npm test -w packages/hotkeys",
    "test:hotkeys:qunit": "npm run test:qunit -w packages/hotkeys",
    "test:kiosk": "npm test -w packages/kiosk-keyboard",
    "test:kiosk:qunit": "npm run test:qunit -w packages/kiosk-keyboard",
    "test:kiosk:e2e": "npm run test:e2e -w packages/kiosk-keyboard",
    "test:kiosk:e2e:open": "npm run test:e2e:open -w packages/kiosk-keyboard",
    "test:kiosk:e2e:update": "npm run test:e2e:update -w packages/kiosk-keyboard",
    "test:kiosk:e2e:update:all-devices": "npm run test:e2e:update:all-devices -w packages/kiosk-keyboard",
    "test:kiosk:e2e:flp": "npm run test:e2e:flp -w packages/kiosk-keyboard",
    "test:kiosk:e2e:docs": "npm run test:e2e:docs -w packages/kiosk-keyboard",
    "test:kiosk:e2e:phone": "npm run test:e2e:phone -w packages/kiosk-keyboard",
    "test:kiosk:e2e:tablet": "npm run test:e2e:tablet -w packages/kiosk-keyboard",
    "test:kiosk-webc": "npm test -w packages/kiosk-keyboard-webc",
    "test:kiosk-webc:component": "npm run test:component -w packages/kiosk-keyboard-webc",
    "test:kiosk-webc:e2e": "npm run test:e2e -w packages/kiosk-keyboard-webc",
    "test:kiosk-webc:e2e:open": "npm run test:e2e:open -w packages/kiosk-keyboard-webc",
    "test:kiosk-webc:e2e:update": "npm run test:e2e:update -w packages/kiosk-keyboard-webc",
    "test:kiosk-webc:e2e:update:all-devices": "npm run test:e2e:update:all-devices -w packages/kiosk-keyboard-webc",
    "test:kiosk-webc:e2e:phone": "npm run test:e2e:phone -w packages/kiosk-keyboard-webc",
    "test:kiosk-webc:e2e:tablet": "npm run test:e2e:tablet -w packages/kiosk-keyboard-webc",
    "test:demo:webc-bundle": "node tools/check-demo-webc-bundle.mjs",
    "test:packages:smoke": "node tools/check-package-smoke.mjs",
    "test:e2e:all-devices": "concurrently --kill-others-on-fail -n kb,webc \"npm run test:e2e:all-devices -w packages/kiosk-keyboard\" \"npm run test:e2e:all-devices -w packages/kiosk-keyboard-webc\"",
    "test:e2e:all-devices:sequential": "npm run test:e2e:all-devices:sequential -w packages/kiosk-keyboard && npm run test:e2e:all-devices:sequential -w packages/kiosk-keyboard-webc",
    "test:e2e:update:all": "npm run test:e2e:update:all-devices -w packages/kiosk-keyboard && npm run test:e2e:update:all-devices -w packages/kiosk-keyboard-webc",
    "lint": "oxlint packages/ tools/",
    "lint:ui5": "npm run lint:ui5 --workspaces --if-present",
    "lint:fix": "oxlint --fix packages/ tools/",
    "fmt": "oxfmt --ignore-path .oxfmtignore .",
    "fmt:check": "oxfmt --ignore-path .oxfmtignore --check .",
    "typecheck": "npm run typecheck:hotkeys && npm run typecheck:hotkeys:test && npm run typecheck:kiosk && npm run typecheck:kiosk:test && npm run typecheck:kiosk:e2e && npm run typecheck:kiosk-webc && npm run typecheck:kiosk-webc:e2e && npm run typecheck:demo && npm run typecheck:tools",
    "typecheck:hotkeys": "npm run typecheck -w packages/hotkeys",
    "typecheck:hotkeys:test": "tsc -p packages/hotkeys/test/tsconfig.json --noEmit",
    "typecheck:kiosk": "npm run typecheck -w packages/kiosk-keyboard",
    "typecheck:kiosk:test": "tsc -p packages/kiosk-keyboard/test/tsconfig.json --noEmit",
    "typecheck:kiosk-webc": "npm run typecheck -w packages/kiosk-keyboard-webc",
    "typecheck:kiosk-webc:e2e": "npm run typecheck:e2e -w packages/kiosk-keyboard-webc",
    "typecheck:kiosk:e2e": "npm run typecheck:e2e -w packages/kiosk-keyboard",
    "typecheck:demo": "npm run typecheck -w packages/demo-app",
    "typecheck:tools": "tsc -p tools/tsconfig.json --noEmit",
    "test:tools": "node --test tools/test/*.test.mjs",
    "report:visual:kiosk": "npm run test:e2e:report -w packages/kiosk-keyboard",
    "report:visual:webc": "npm run test:e2e:report -w packages/kiosk-keyboard-webc",
    "browse:baselines": "node tools/visual-browse.mjs packages/kiosk-keyboard/test/e2e/__baselines__ packages/kiosk-keyboard-webc/test/e2e/__baselines__ --include-screenshots",
    "browse:baselines:kiosk": "node tools/visual-browse.mjs packages/kiosk-keyboard/test/e2e/__baselines__ --include-screenshots",
    "browse:baselines:webc": "node tools/visual-browse.mjs packages/kiosk-keyboard-webc/test/e2e/__baselines__ --include-screenshots",
    "check:baselines": "node tools/check-visual-baselines.mjs",
    "check": "npm run fmt:check && npm run lint && npm run lint:ui5 && npm run check:baselines && npm run typecheck && npm run test:tools && npm test && npm run test:packages:smoke && npm run test:demo:webc-bundle && npm run test:e2e:all-devices:sequential",
    "check:parallel": "npm run fmt:check && npm run lint && npm run lint:ui5 && npm run check:baselines && npm run typecheck && npm run test:tools && npm test && npm run test:packages:smoke && npm run test:demo:webc-bundle && npm run test:e2e:all-devices",
    "postinstall": "patch-package && node patches/apply-nested.mjs",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "~20.1.0",
    "@commitlint/config-conventional": "~20.0.0",
    "@openui5/types": "1.144.0",
    "@puppeteer/browsers": "~2.13.0",
    "@types/node": "~22.0.0",
    "@types/qunit": "~2.19.13",
    "@types/sinon": "~21.0.0",
    "@ui5/linter": "~1.20.18",
    "@ui5/webcomponents-tools": "2.20.0",
    "@wdio/cli": "~9.27.0",
    "@wdio/local-runner": "~9.27.0",
    "@wdio/mocha-framework": "~9.27.0",
    "@wdio/spec-reporter": "~9.27.0",
    "@wdio/visual-reporter": "~0.4.12",
    "concurrently": "~9.2.1",
    "husky": "~9.1.7",
    "less-openui5": "~0.11.6",
    "lint-staged": "~16.2.7",
    "oxfmt": "~0.41.0",
    "oxlint": "~1.56.0",
    "patch-package": "~8.0.1",
    "rimraf": "~6.1.3",
    "tree-kill": "~1.2.2",
    "typescript": "~6.0.2",
    "wdio-qunit-service": "~2.0.0"
  },
  "overrides": {
    "@ui5/webcomponents-tools": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
