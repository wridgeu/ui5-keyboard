{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "jsPlugins": [
    {
      "name": "test-guardrails",
      "specifier": "./tools/oxlint-plugin-test-guardrails.mjs"
    },
    {
      "name": "code-quality",
      "specifier": "./tools/oxlint-plugin-code-quality.mjs"
    },
    {
      "name": "comment-quality",
      "specifier": "./tools/oxlint-plugin-comment-quality.mjs"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "eqeqeq": "warn",
    "complexity": "error",
    "no-useless-call": "error",
    "no-console": "warn",
    "no-underscore-dangle": "off",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unsafe-function-type": "error",
    "unicorn/no-null": "off",
    "unicorn/prefer-event-target": "warn",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/no-static-only-class": "warn",
    "unicorn/prefer-global-this": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "oxc/no-accumulating-spread": "error",
    "code-quality/no-double-type-assertion": "error",
    "code-quality/no-console-only-catch": "warn",
    "code-quality/no-redundant-boolean-return": "warn",
    "code-quality/no-em-dash": "warn",
    "comment-quality/no-narrator-comment": "warn",
    "comment-quality/no-section-divider": "warn",
    "comment-quality/no-placeholder-comment": "warn",
    "comment-quality/no-hedging-comment": "warn",
    "comment-quality/no-edit-narration": "warn",
    "comment-quality/no-issue-reference-comment": "warn",
    "comment-quality/no-obvious-comment": "warn"
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts", "*.qunit.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "no-unused-expressions": "off",
        "no-console": "off",
        "import/no-unassigned-import": "off",
        "code-quality/no-double-type-assertion": "off"
      }
    },
    {
      "files": ["packages/*/src/**/*.ts"],
      "rules": {
        "no-await-in-loop": "warn",
        "no-console": [
          "warn",
          {
            "allow": ["warn", "error"]
          }
        ],
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["packages/kiosk-keyboard-webc/src/*Template.tsx"],
      "rules": {
        "oxc/no-this-in-exported-function": "off"
      }
    },
    {
      "files": ["packages/demo-app/**/*.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["packages/*/test/pages/*.js"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["tools/*.ts", "tools/*.mjs", "patches/*.mjs"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/*/test/**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "page",
            "property": "pause",
            "message": "Remove the debug pause; rely on web-first assertions (expect().toHaveClass etc.) instead."
          },
          {
            "object": "browser",
            "property": "pause",
            "message": "Remove the debug pause; rely on web-first assertions (expect().toHaveClass etc.) instead."
          }
        ]
      }
    },
    {
      "files": ["packages/*/test/e2e/**/*.{ts,js}"],
      "rules": {
        "test-guardrails/no-hard-wait": "error"
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/", "**/*.gen.d.ts"]
}
