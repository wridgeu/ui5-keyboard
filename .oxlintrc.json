{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "jsPlugins": [
    {
      "name": "test-guardrails",
      "specifier": "./tools/eslint-plugin-test-guardrails.mjs"
    }
  ],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "eqeqeq": "warn",
    "no-console": "warn",
    "@typescript-eslint/no-explicit-any": "error",
    "unicorn/no-null": "off",
    "unicorn/prefer-event-target": "off",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/no-static-only-class": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/consistent-function-scoping": "off"
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts", "*.qunit.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "no-unused-expressions": "off",
        "no-shadow": "off",
        "no-console": "off",
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["packages/*/src/**/*.ts"],
      "rules": {
        "no-console": "off",
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["packages/demo-app/**/*.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["tools/*.ts", "tools/*.mjs"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/*/test/**/*.ts"],
      "rules": {
        "test-guardrails/no-browser-pause": "error"
      }
    },
    {
      "files": ["packages/*/test/e2e/**/*.ts"],
      "rules": {
        "test-guardrails/no-hard-wait": "error"
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/", "**/*.js"]
}
